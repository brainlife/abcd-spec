  "brainlife": {
    "_id": "6a99e5d7d90f157078ed790c",
    "desc": "TODO",
    "name": "neuro/ome-zarr",
    "original": {
      "desc": "OME-Zarr (OME-NGFF) multidimensional bioimaging store",
      "readme": "# neuro/ome-zarr\n\nA directory-backed OME-Zarr image store. The store is staged as one logical input; chunk objects are not registered as separate files.\n\nBrainlife validates root OME-NGFF metadata before registering virtual S3 datasets. OME-Zarr 0.5 is recommended for BIDS compatibility."
    },
    "readme": "# neuro/ome-zarr\n\nA directory-backed OME-Zarr image store. The store is staged as one logical input; chunk objects are not registered as separate files.\n\nBrainlife validates root OME-NGFF metadata before registering virtual S3 datasets. OME-Zarr 0.5 is recommended for BIDS compatibility."
  },
