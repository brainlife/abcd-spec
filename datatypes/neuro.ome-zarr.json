  "brainlife": {
    "_id": "6a99e5d7d90f157078ed790c",
    "desc": "Multiscale microscopy image or label volume as an OME-Zarr (OME-NGFF) store; OME-Zarr 0.5 recommended for BIDS.",
    "name": "neuro/ome-zarr",
    "original": {
      "desc": "OME-Zarr (OME-NGFF) multidimensional bioimaging store",
      "readme": "# neuro/ome-zarr\n\nA directory-backed OME-Zarr image store. The store is staged as one logical input; chunk objects are not registered as separate files.\n\nBrainlife validates root OME-NGFF metadata before registering virtual S3 datasets. OME-Zarr 0.5 is recommended for BIDS compatibility."
    },
    "readme": "# neuro/ome-zarr\n\nA directory-backed OME-Zarr image store. The store is staged as one logical input; chunk objects are not registered as separate files.\n\nBrainlife validates root OME-NGFF metadata before registering virtual S3 datasets. OME-Zarr 0.5 is recommended for BIDS compatibility.\n\n**Sharing:** Tier 2 (pseudonymised participant-level) by default.\n\nFull record: https://github.com/brainlife/abcd-spec/blob/master/datatypes/neuro.ome-zarr.json"
  },
  "files": [
    {
      "desc": "OME-Zarr store root",
      "dirname": "data.ome.zarr",
      "id": "zarr",
      "required": true
    },
    {
      "desc": "BIDS microscopy JSON sidecar (e.g. PixelSize, PixelSizeUnits).",
      "filename": "image.json",
      "id": "json",
      "proposed": true,
      "required": false
    }
  ],
  "governance": {
    "default_tier": 2,
    "human_neurodata": "depends",
    "identifying_risks": [
      "Specimen IDs in OME metadata may link to a donor."
    ],
    "information_kinds": [
      "anatomy"
    ],
    "rationale": "Tool 1 step 2: human status depends on the specimen; participant-level tissue images carry no direct identifiers (Tier 2), non-human data is Tier 1.",
    "sharing_cautions": [
      "Confirm species and donor consent terms before sharing human tissue images."
    ],
    "tier_conditions": [
      "Tier 1 when the specimen is non-human (e.g. mouse) or synthetic.",
      "Tier 2 for human tissue linked to a donor or specimen code."
    ]
  },
