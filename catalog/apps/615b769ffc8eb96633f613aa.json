{
  "spec": "brainlife-app/2.0",
  "name": "bedpostx",
  "version": "main",
  "summary": "FSL's bedpostx app for brainlife",
  "description": "unknown",
  "kind": "native",
  "topics": [],
  "registry": {
    "id": "615b769ffc8eb96633f613aa",
    "github": "sandrahanekamp/app-bedpostx",
    "branch": "main"
  },
  "inputs": [
    {
      "id": "dwi",
      "datatype": "neuro/dwi",
      "datatype_tags": [
        "preprocessed"
      ],
      "optional": false,
      "multi": false,
      "description": "A 4D series of data volumes. This will include diffusion-weighted volumes and volume(s) with no diffusion weighting.",
      "config_keys": [
        "dwi",
        "bvecs",
        "bvals",
        "sbref",
        "sbref_json"
      ]
    },
    {
      "id": "mask",
      "datatype": "neuro/mask",
      "datatype_tags": [
        "dwi",
        "brain",
        "preprocessed"
      ],
      "optional": false,
      "multi": false,
      "description": "3D binary brain mask volume derived from running bet on nodif (i.e. on a volume with no diffusion weighting). Created using FSL Brain Extraction (BET) on DWI brainlife/app-FSLBET",
      "config_keys": [
        "mask"
      ]
    }
  ],
  "outputs": [
    {
      "id": "output",
      "datatype": "neuro/FSLBedpostX",
      "datatype_tags": [
        "bedpostx",
        "preprocessed",
        "dwi"
      ],
      "description": "This folder contains the entire set of folders and files outputted by the FSL BedpostX  process",
      "datatype_tags_pass": "dwi"
    }
  ],
  "parameters": [
    {
      "id": "nf",
      "type": "number",
      "description": "Maximum number of fibres to fit in each voxel.",
      "default": 3
    },
    {
      "id": "bi",
      "type": "number",
      "description": "burnin period, default 1000",
      "default": 1000
    },
    {
      "id": "fudge",
      "type": "number",
      "description": "fudge (an integer) \u2013 ARD fudge factor",
      "default": 1
    }
  ],
  "runtime": {
    "container": "brainlife/fsl:6.0.1",
    "resources": {
      "cpus": 8,
      "walltime_hours": 16
    }
  },
  "doi": "10.25663/brainlife.app.578"
}
