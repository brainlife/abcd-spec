{
  "spec": "brainlife-app/2.0",
  "name": "Fit Constrained Deconvolution Model for Tracking",
  "version": "csd_generation-v1.0",
  "summary": "This will fit the constrained spherical deconvolution model to an input DWI image. The outputs from this can be used for subsequent tracking apps.",
  "description": "unknown",
  "kind": "native",
  "topics": [],
  "registry": {
    "id": "5db224e98aeeee0f87f25c1f",
    "github": "bacaron/app-mrtrix3-act",
    "branch": "csd_generation-v1.0"
  },
  "inputs": [
    {
      "id": "dwi",
      "datatype": "neuro/dwi",
      "datatype_tags": [],
      "optional": false,
      "multi": false,
      "description": "The path to the DWI datatype",
      "config_keys": [
        "dwi",
        "bvecs",
        "bvals"
      ]
    },
    {
      "id": "brainmask",
      "datatype": "neuro/mask",
      "datatype_tags": [
        "brain",
        "dwi"
      ],
      "optional": true,
      "multi": false,
      "description": "The path to the mask datatype of the brainmask for the DWI",
      "config_keys": [
        "brainmask"
      ]
    },
    {
      "id": "mask",
      "datatype": "neuro/mask",
      "datatype_tags": [
        "5tt_masks"
      ],
      "optional": true,
      "multi": false,
      "description": "The path to the mask datatype of the 5 tissue probability mask from Tissue-type Segmentation (optional). If not inputted, will be generated using MRtrix3",
      "config_keys": [
        "mask"
      ]
    },
    {
      "id": "anat",
      "datatype": "neuro/anat/t1w",
      "datatype_tags": [],
      "optional": false,
      "multi": false,
      "description": "The path to the anat/t1w datatype",
      "config_keys": [
        "anat"
      ]
    }
  ],
  "outputs": [
    {
      "id": "csd",
      "datatype": "neuro/csd",
      "datatype_tags": [],
      "description": "The CSD FOD images",
      "datatype_tags_pass": "dwi"
    },
    {
      "id": "5tt",
      "datatype": "neuro/mask",
      "datatype_tags": [
        "5tt_masks"
      ],
      "description": "The 5 tissue probability image generated using MRtrix3"
    },
    {
      "id": "brainmask",
      "datatype": "neuro/mask",
      "datatype_tags": [
        "dwi",
        "brain"
      ],
      "description": "The brainmask of the DWI image"
    }
  ],
  "parameters": [
    {
      "id": "lmax",
      "type": "number",
      "description": "spherical harmonic order (lmax) for csd estimation. see https://mrtrix.readthedocs.io/en/3.0_rc2/constrained_spherical_deconvolution/lmax.html for more information on which value to choose",
      "default": 8
    },
    {
      "id": "premask",
      "type": "boolean",
      "description": "If T1 has been skull stripped, select true",
      "default": false,
      "advanced": true
    },
    {
      "id": "norm",
      "type": "boolean",
      "description": "multi-tissue intensity normalization",
      "default": false
    },
    {
      "id": "ensemble",
      "type": "boolean",
      "description": "if true, will ensemble through max lmax. else, will generate requested lmax",
      "default": true
    }
  ],
  "runtime": {
    "container": "brainlife/mrtrix3:3.0.0",
    "resources": {
      "cpus": 8,
      "walltime_hours": 48
    }
  },
  "doi": "10.25663/brainlife.app.238"
}
