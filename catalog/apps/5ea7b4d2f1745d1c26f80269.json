    },
    {
      "id": "split_b_S0",
      "type": "number",
      "description": "Value to split the bvals to estimate S0 for the two-stage process of fitting.",
      "default": 200
    },
    {
      "id": "b0_threshold",
      "type": "number",
      "description": "Threshold value for the b0 bval.",
      "default": 0
    },
    {
      "id": "command",
      "type": "string",
      "description": "unknown",
      "default": "dipy_fit_ivim",
      "readonly": true
    }
  ],
  "runtime": {
    "container": "brainlife/dipy:1.1.1",
    "resources": {
      "cpus": 6
    }
  },
  "doi": "10.25663/brainlife.app.322"
}
