{
  "spec": "brainlife-app/2.0",
  "name": "Map tract endpoint ROIs to cortical surface for quantitative analyses - fsaverage (No smoothing)",
  "version": "endpoints-fsaverage-v1.0",
  "summary": "This app will map volumated measure files (i.e. tensor, NODDI) to the cortical surface following Fukutomi et al (2018; 10.1016/j.neuroimage.2018.02.017) using Connectome Workbench.",
  "description": "unknown",
  "kind": "native",
  "topics": [
    "postprocessing"
  ],
  "registry": {
    "id": "63fba8f3c538c16a82500864",
    "github": "brainlife/app-cortex-tissue-mapping",
    "branch": "endpoints-fsaverage-v1.0"
  },
  "inputs": [
    {
      "id": "rois",
      "datatype": "neuro/rois",
      "datatype_tags": [
        "warped"
      ],
      "optional": false,
      "multi": false,
      "description": "unknown",
      "config_keys": [
        "rois"
      ]
    },
    {
      "id": "cortexmap",
      "datatype": "neuro/cortexmap",
      "datatype_tags": [],
      "optional": true,
      "multi": false,
      "description": "If cortexmap datatype has already been generated, update the datatype with the endpoint ROIs",
      "config_keys": [
        "cortexmap"
      ]
    }
  ],
  "outputs": [
    {
      "id": "cortexmap",
      "datatype": "neuro/cortexmap",
      "datatype_tags": [
        "endpoints",
        "fsaverage"
      ],
      "description": "The cortexmap output, containing the surfaces and mapped data",
      "datatype_tags_pass": "rois"
    },
    {
      "id": "raw",
      "datatype": "raw",
      "datatype_tags": [
        "cortexmap_derivatives",
        "fsaverage"
      ],
      "description": "A directory containing all of the derivatives generated. Useful for QA and debugging"
    }
  ],
  "parameters": [
    {
      "id": "fsurfparc",
      "type": "enum",
      "description": "Parcellation from freesurfer wanted to for future stats",
      "default": "aparc.a2009s",
      "options": [
        {
          "value": "aparc",
          "label": "aparc",
          "description": "Desikan-Killiany"
        },
        {
          "value": "aparc.a2009s",
          "label": "aparc.a2009s",
          "description": "Destrieux Atlas "
        },
        {
          "value": "aparc.DKTatlas",
          "label": "aparc.DKTatlas",
          "description": "DKT Atlas"
        }
      ],
      "advanced": true
    },
    {
      "id": "freesurfer",
      "type": "enum",
      "description": "unknown",
      "default": "fsaverage",
      "options": [
        {
          "value": "fsaverage",
          "label": "fsaverage",
          "description": "fsaverage"
        },
        {
          "value": "fsaverage3",
          "label": "fsaverage3",
          "description": "fsaverage3"
        },
        {
          "value": "fsaverage4",
          "label": "fsaverage4",
          "description": "fsaverage4"
        },
        {
          "value": "fsaverage5",
          "label": "fsaverage5",
          "description": "fsaverage5"
        },
        {
          "value": "fsaverage6",
          "label": "fsaverage6",
          "description": "fsaverage6"
        }
      ]
    }
  ],
  "runtime": {
    "container": "brainlife/connectome_workbench:1.5.0",
    "resources": {
      "cpus": 8,
      "walltime_hours": 2.5
    },
    "licenses_required": [
      "FREESURFER_LICENSE"
    ]
  },
  "doi": "10.25663/brainlife.app.737",
  "deprecated_by": "64420964d391caf6efc9b767"
}
