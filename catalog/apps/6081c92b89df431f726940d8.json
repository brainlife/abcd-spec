{
  "spec": "brainlife-app/2.0",
  "name": "Align T2  to T1 using FSL Flirt",
  "version": "v1.0",
  "summary": "Aligns a T2-weighted image to an ACPC-aligned T1-weighted image with FSL flirt (brain-extracted registration), producing a T2w image in T1w space.",
  "description": "Optionally crops the T2w image with robustfov, brain-extracts both images with bet, estimates a flirt transform from the T2w brain to the T1w brain with the chosen degrees of freedom and cost function, and applies it to the whole T2w image on the T1w grid. Use it so T2w data can be used alongside the T1w image (for example in FreeSurfer or myelin mapping).",
  "kind": "native",
  "topics": [
    "anatomy",
    "brainlife-app",
    "fsl",
    "registration"
  ],
  "registry": {
    "id": "6081c92b89df431f726940d8",
    "github": "brainlife/app-align-t2-to-t1",
    "branch": "v1.0"
  },
  "inputs": [
    {
      "id": "t1",
      "datatype": "neuro/anat/t1w",
      "datatype_tags": [
        "acpc_aligned"
      ],
      "optional": false,
      "multi": false,
      "description": "reference t1 to align t2 data to",
      "config_keys": [
        "t1"
      ]
    },
    {
      "id": "t2",
      "datatype": "neuro/anat/t2w",
      "datatype_tags": [],
      "optional": false,
      "multi": false,
      "description": "t2 data to align",
      "config_keys": [
        "t2"
      ]
    }
  ],
  "outputs": [
    {
      "id": "output",
      "datatype": "neuro/anat/t2w",
      "datatype_tags": [
        "acpc_aligned"
      ],
      "description": "T2-weighted image resampled into the ACPC-aligned T1w space.",
      "datatype_tags_pass": "t2"
    }
  ],
  "parameters": [
    {
      "id": "crop",
      "type": "boolean",
      "description": "If true, will crop using fsl robustfov. if false, will not. default == false",
      "default": false,
      "advanced": true
    },
    {
      "id": "cost",
      "type": "enum",
      "description": "Cost function used by flirt to estimate the T2-to-T1 transform (mutual information by default).",
      "default": "mutualinfo",
      "options": [
        {
          "value": "mutualinfo",
          "label": "mutualinfo",
          "description": "mutual info"
        },
        {
          "value": "corratio",
          "label": "corratio",
          "description": "corratio"
        },
        {
          "value": "normcorr",
          "label": "normcorr",
          "description": "norm corr"
        },
        {
          "value": "normmi",
          "label": "normmi",
          "description": "norm mutual info"
        },
        {
          "value": "leastsq",
          "label": "leastsq",
          "description": "least-squares"
        },
        {
          "value": "labeldiff",
          "label": "labeldiff",
          "description": "labeldiff"
        },
        {
          "value": "bbr",
          "label": "bbr",
          "description": "bbr"
        }
      ],
      "advanced": true
    },
    {
      "id": "dof",
      "type": "number",
      "description": "Degrees of freedom of the flirt transform (for example 6 rigid, 12 affine).",
      "default": 12,
      "advanced": true
    }
  ],
  "runtime": {
    "container": "brainlife/fsl:5.0.11",
    "resources": {
      "cpus": 1,
      "memory_gb": 12,
      "walltime_hours": 0.75
    }
  },
  "doi": "10.25663/brainlife.app.510",
  "software": [
    {
      "name": "FSL",
      "version": "5.0.11",
      "url": "https://fsl.fmrib.ox.ac.uk/"
    }
  ],
  "failure_modes": [
    {
      "message": "something went wrong. check derivatives",
      "cause": "flirt did not write output/t2.nii.gz.",
      "fix": "Check the logs; try crop=true for large fields of view or another cost function."
    }
  ]
}
