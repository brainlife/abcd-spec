{
  "spec": "brainlife-app/2.0",
  "name": "RecoBundles",
  "version": "1.1.1",
  "summary": "Extracts white matter bundles from a whole-brain .trk tractogram with DIPY RecoBundles using the HCP842 bundle atlas, and outputs a WMC classification plus recognised bundles and labels.",
  "description": "Registers the tractogram to the HCP842 atlas with streamline-based linear registration (SLR) and recognises each atlas model bundle with RecoBundles, optionally refining the result. Use it for automatic bundle segmentation of a whole-brain tractogram in subject space. The atlas is downloaded at run time by DIPY.",
  "kind": "native",
  "topics": [
    "brainlife-app",
    "diffusion-mri",
    "dipy",
    "dwi",
    "segmentation",
    "tract-segmentation"
  ],
  "registry": {
    "id": "5bbfbbc71f00c80027644894",
    "github": "dipy/bl_apps_dipy_recobundles",
    "branch": "1.1.1"
  },
  "inputs": [
    {
      "id": "track",
      "datatype": "neuro/track/trk",
      "datatype_tags": [],
      "optional": false,
      "multi": false,
      "description": "Whole-brain tractogram (.trk).",
      "config_keys": [
        "streamline_files"
      ]
    }
  ],
  "outputs": [
    {
      "id": "wmc",
      "datatype": "neuro/wmc",
      "datatype_tags": [],
      "description": "White matter classification of the input streamlines into the recognised bundles, with per-tract JSON for visualisation."
    },
    {
      "id": "output",
      "datatype": "raw",
      "datatype_tags": [
        "wm_tracts",
        "tracts_labels"
      ],
      "description": "Recognised bundle streamlines and their labels."
    }
  ],
  "parameters": [
    {
      "id": "greater_than",
      "type": "number",
      "description": "Keep streamlines that have a length greater than this value.",
      "default": 50
    },
    {
      "id": "less_than",
      "type": "number",
      "description": "Keep streamlines have a length lesser than this value.",
      "default": 1000000
    },
    {
      "id": "no_slr",
      "type": "boolean",
      "description": "Disable streamline-based linear registration of the tractogram to the atlas.",
      "default": false
    },
    {
      "id": "clust_thr",
      "type": "number",
      "description": "MDF distance threshold for all streamlines.",
      "default": 15
    },
    {
      "id": "reduction_thr",
      "type": "number",
      "description": "Reduce search space by (mm).",
      "default": 15
    },
    {
      "id": "reduction_distance",
      "type": "enum",
      "description": "Reduction distance type.",
      "default": "mdf",
      "options": [
        {
          "value": "mam",
          "label": "Maximum Average Minimum Distance"
        },
        {
          "value": "mdf",
          "label": "Minimum Average Direct-Flip Distance"
        }
      ]
    },
    {
      "id": "model_clust_thr",
      "type": "number",
      "description": "MDF distance threshold for the model bundles.",
      "default": 2.5
    },
    {
      "id": "pruning_thr",
      "type": "number",
      "description": "Pruning after matching.",
      "default": 8
    },
    {
      "id": "pruning_distance",
      "type": "enum",
      "description": "Pruning distance type.",
      "default": "mdf",
      "options": [
        {
          "value": "mam",
          "label": "Maximum Average Minimum Distance"
        },
        {
          "value": "mdf",
          "label": "Minimum Average Direct-Flip Distance"
        }
      ]
    },
    {
      "id": "slr_metric",
      "type": "enum",
      "description": "Metric used for the SLR registration.",
      "default": "symmetric",
      "options": [
        {
          "value": "asymmetric",
          "label": "Asymmetric"
        },
        {
          "value": "diagonal",
          "label": "Diagonal"
        },
        {
          "value": "symmetric",
          "label": "Symmetric"
        }
      ]
    },
    {
      "id": "slr_transform",
      "type": "enum",
      "description": "Transform type for SLR (translation, rigid, similarity or scaling).",
      "default": "similarity",
      "options": [
        {
          "value": "rigid",
          "label": "Rigid"
        },
        {
          "value": "scaling",
          "label": "Scaling"
        },
        {
          "value": "similarity",
          "label": "Similarity"
        },
        {
          "value": "translation",
          "label": "Translation"
        }
      ]
    },
    {
      "id": "slr_matrix",
      "type": "enum",
      "description": "Size of the streamline subset used for SLR (nano 100 to huge 1200 streamlines).",
      "default": "small",
      "options": [
        {
          "value": "nano",
          "label": "Nano"
        },
        {
          "value": "tiny",
          "label": "Tiny"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "huge",
          "label": "Huge"
        }
      ]
    },
    {
      "id": "refine",
      "type": "boolean",
      "description": "Enable refine of recognized bundle.",
      "default": false
    },
    {
      "id": "r_reduction_thr",
      "type": "number",
      "description": "Refine reduce search space by (mm).",
      "default": 12
    },
    {
      "id": "r_pruning_thr",
      "type": "number",
      "description": "Refine pruning after matching.",
      "default": 6
    },
    {
      "id": "no_r_slr",
      "type": "boolean",
      "description": "Don't enable Refine local Streamline-based Linear Registration.",
      "default": false
    }
  ],
  "runtime": {
    "container": "brainlife/dipy:1.4.0",
    "resources": {
      "cpus": 8
    }
  },
  "doi": "10.25663/brainlife.app.113",
  "software": [
    {
      "name": "DIPY",
      "version": "1.4.0",
      "url": "https://dipy.org"
    }
  ],
  "citations": [
    {
      "doi": "10.3389/fninf.2014.00008",
      "text": "Garyfallidis E, et al. Dipy, a library for the analysis of diffusion MRI data. Front Neuroinform 8:8 (2014)."
    },
    {
      "doi": "10.1038/s41597-019-0073-y",
      "text": "Avesani P, et al. The open diffusion data derivatives, brain data upcycling via integrated publishing of derivatives and reproducible open cloud services. Sci Data 6:69 (2019)."
    }
  ]
}
