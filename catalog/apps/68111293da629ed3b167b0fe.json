{
  "spec": "brainlife-app/2.0",
  "name": "DWI-to-Anatomical MRI Registration",
  "version": "v0.3",
  "summary": "A reproducible and automated pipeline to align diffusion-weighted imaging (DWI) data to anatomical MRI references (e.g., T1-weighted) using configurable transformation stages.",
  "description": "unknown",
  "kind": "native",
  "topics": [],
  "registry": {
    "id": "68111293da629ed3b167b0fe",
    "github": "gamorosino/app-registration-dwi2anat",
    "branch": "v0.3"
  },
  "inputs": [
    {
      "id": "dwi",
      "datatype": "neuro/dwi",
      "datatype_tags": [],
      "optional": false,
      "multi": false,
      "description": "unknown",
      "config_keys": [
        "dwi",
        "bvecs",
        "bvals",
        "sbref",
        "sbref_json"
      ]
    },
    {
      "id": "t1_fixed",
      "datatype": "neuro/anat/t1w",
      "datatype_tags": [],
      "optional": true,
      "multi": false,
      "description": "unknown",
      "config_keys": [
        "t1"
      ]
    },
    {
      "id": "t2_fixed",
      "datatype": "neuro/anat/t2w",
      "datatype_tags": [],
      "optional": true,
      "multi": false,
      "description": "unknown",
      "config_keys": [
        "t2"
      ]
    },
    {
      "id": "tensor_fixed",
      "datatype": "neuro/tensor",
      "datatype_tags": [],
      "optional": true,
      "multi": false,
      "description": "unknown",
      "config_keys": [
        "fa",
        "md",
        "rd",
        "ad",
        "cl",
        "cp",
        "cs",
        "tensors",
        "kurtosis",
        "ga",
        "mk",
        "ak",
        "rk",
        "rgb"
      ]
    }
  ],
  "outputs": [
    {
      "id": "transformations",
      "datatype": "neuro/transform/nifti",
      "datatype_tags": [],
      "description": "unknown"
    },
    {
      "id": "transformed",
      "datatype": "neuro/dwi",
      "datatype_tags": [],
      "description": "unknown"
    },
    {
      "id": "figures",
      "datatype": "generic/images",
      "datatype_tags": [
        "qc_images"
      ],
      "description": "unknown"
    }
  ],
  "parameters": [
    {
      "id": "settings",
      "type": "enum",
      "description": "The `settings` parameter controls the depth of the multiresolution (pyramidal) registration strategy used by ANTs. Higher settings correspond to more levels in the registration pyramid, starting from coarse alignment and progressively refining toward finer spatial correspondence.",
      "default": "4",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ]
    },
    {
      "id": "transformation",
      "type": "enum",
      "description": "unknown",
      "default": "rigid",
      "options": [
        {
          "value": "translation",
          "label": "1",
          "description": "Translation"
        },
        {
          "value": "rigid",
          "label": "2",
          "description": "Rigid Transformation"
        },
        {
          "value": "affine",
          "label": "3",
          "description": "Affine Transformation"
        },
        {
          "value": "nonlinear",
          "label": "4",
          "description": "Diffeomorphic Symmetric (SyN) Transformation"
        }
      ]
    },
    {
      "id": "qc_wm",
      "type": "boolean",
      "description": "Fits a diffusion tensor model on both the pre- and post-registration DWI, thresholds FA \u2265 0.35 to produce a white matter mask, and overlays it in blue on all QC images so you can verify that the WM geometry aligns with the reference anatomy after registration.",
      "default": false
    }
  ],
  "runtime": {
    "container": "gamorosino/tract_align:v1.1",
    "resources": {
      "cpus": 1,
      "walltime_hours": 2
    }
  },
  "doi": "10.25663/brainlife.app.857"
}
