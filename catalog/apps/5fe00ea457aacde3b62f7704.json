{
  "spec": "brainlife-app/2.0",
  "name": "Generate images of data mapped to cortical surface",
  "version": "v1.0",
  "summary": "Renders JPEG images of cortical surface maps (cortexmap) on FreeSurfer or fsaverage surfaces with PySurfer, for visual quality control.",
  "description": "Loads each measure in a cortexmap datatype and draws it on the chosen surface (midthickness, pial, white or inflated) of the subject or an fsaverage template, scaling the colormap between the chosen percentiles of supra-threshold values, and saves medial and lateral views as JPEGs. Use it to inspect or illustrate surface-mapped measures. It is a visualisation utility and does not change the data.",
  "kind": "native",
  "topics": [
    "visualization",
    "quality-control",
    "surface-analysis",
    "freesurfer",
    "brainlife-app"
  ],
  "registry": {
    "id": "5fe00ea457aacde3b62f7704",
    "github": "brainlife/app-cortex-mapping-images",
    "branch": "v1.0"
  },
  "inputs": [
    {
      "id": "freesurfer",
      "datatype": "neuro/freesurfer",
      "datatype_tags": [],
      "optional": false,
      "multi": false,
      "description": "Path to the freesurfer dataset. Needed for image generation, even when surface = midthickness",
      "config_keys": [
        "freesurfer"
      ]
    },
    {
      "id": "cortexmap",
      "datatype": "neuro/cortexmap",
      "datatype_tags": [],
      "optional": false,
      "multi": false,
      "description": "Path to cortexmap data",
      "config_keys": [
        "cortexmap"
      ]
    }
  ],
  "outputs": [
    {
      "id": "images",
      "datatype": "generic/images",
      "datatype_tags": [
        "cortex_mapping",
        "qa_image"
      ],
      "description": "File containing multiple images of medial and lateral views of the cortex mapped data on the chosen surface"
    }
  ],
  "parameters": [
    {
      "id": "surface",
      "type": "enum",
      "description": "Surface to use in the image. Pial, white, and inflated come from freesurfer's standard segmentation. Midthickness comes from Cortex Mapping datatype",
      "default": "midthickness",
      "options": [
        {
          "value": "midthickness",
          "label": "midthickness",
          "description": "midthickness"
        },
        {
          "value": "pial",
          "label": "pial",
          "description": "pial"
        },
        {
          "value": "white",
          "label": "white",
          "description": "white"
        },
        {
          "value": "inflated",
          "label": "inflated",
          "description": "inflated"
        }
      ]
    },
    {
      "id": "min_percentile",
      "type": "number",
      "description": "Minimum percentile to map to colorbar",
      "default": 4,
      "advanced": true
    },
    {
      "id": "max_percentile",
      "type": "number",
      "description": "Maximum percentile to map to colorbar",
      "default": 96,
      "advanced": true
    },
    {
      "id": "threshold",
      "type": "number",
      "description": "Threshold value to use for computing minimum,  median, and maximum values to map colormap to.\n\nWill update to plot only data above threshold once functionality is available.",
      "default": 1e-09,
      "advanced": true
    },
    {
