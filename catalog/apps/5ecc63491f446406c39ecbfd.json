    },
    {
      "id": "max_length",
      "type": "number",
      "description": "max length of streamlines",
      "default": 200
    },
    {
      "id": "lmax",
      "type": "number",
      "description": "lmax",
      "default": 8
    },
    {
      "id": "roiPair",
      "type": "string",
      "description": "This field is here for whether or not you want to track both hemispheres or one hemisphere at a time. If just one hemisphere is desired, enter the exact ROI number or name from the rois datatype for the lgn of choice (example: '008109'). If both are desired, enter both separated by a space (example: '008109 008209'). Please see ROI datatype for exact name of each.",
      "default": ""
    },
    {
      "id": "oc",
      "type": "string",
      "description": "this field is the exact ROI name or number from the ROI datatype for the optic chiasm. Example: '085'. Please see ROI datatype for exact name of each.",
      "default": ""
    },
    {
      "id": "count",
      "type": "number",
      "description": "total number of streamlines",
      "default": 500
    },
    {
      "id": "probelength",
      "type": "number",
      "description": "Trekker: probe length\nDefault = 0.25",
      "default": 0.25,
      "advanced": true
    },
    {
      "id": "probequality",
      "type": "number",
      "description": "Trekker: Probe quality\nDefault = 4",
      "default": 4,
      "advanced": true
    },
    {
      "id": "proberadius",
      "type": "number",
      "description": "Trekker: probe radius\nDefault =0",
      "default": 0,
      "advanced": true
    },
    {
      "id": "probecount",
      "type": "number",
      "description": "Trekker: probe count\nDefault = 1",
      "default": 1,
      "advanced": true
    },
    {
      "id": "curvatures",
      "type": "string",
      "description": "minimum radius of curvature",
      "default": "0.5"
    },
    {
      "id": "stepsize",
      "type": "string",
      "description": "step size",
      "default": "0.05"
    },
    {
      "id": "maxtrials",
      "type": "number",
      "description": "maximum number of trials",
      "default": 1000000
    },
    {
      "id": "maxsampling",
      "type": "number",
      "description": "max sampling per seed",
      "default": 10000
    },
    {
      "id": "single_lmax",
      "type": "boolean",
      "description": "if want to run on only one lmax, set to true. to ensemble, set to false",
      "default": true
    },
    {
      "id": "minfodamp",
      "type": "string",
      "description": "minimum FOD amplitude",
      "default": "0.025"
    }
  ],
