      "minimum": 0,
      "placeholder": "2"
    }
  ],
  "runtime": {
    "container": "brainlife/freesurfer:6.0.0",
    "resources": {
      "cpus": 8,
      "memory_gb": 60,
      "walltime_hours": 10
