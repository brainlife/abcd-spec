{
  "spec": "brainlife-app/2.0",
  "name": "Segment tractogram into fiber categories",
  "version": "1.3",
  "summary": "Segments all streamlines from an input tractogram in to general categories (i.e. fronto-temporal, parieto-occipital etc).",
  "description": "unknown",
  "kind": "native",
  "topics": [
    "white-matter-segmentation"
  ],
  "registry": {
    "id": "5c3fba22147b69003601ca60",
    "github": "brainlife/app-streamlineCategorySegmentation",
    "branch": "1.3"
  },
  "inputs": [
    {
      "id": "track",
      "datatype": "neuro/track/tck",
      "datatype_tags": [],
      "optional": false,
      "multi": false,
      "description": "Whole brain tractography",
      "config_keys": [
        "track"
      ]
    },
    {
      "id": "freesurfer",
      "datatype": "neuro/freesurfer",
      "datatype_tags": [],
      "optional": false,
      "multi": false,
      "description": "unknown",
      "config_keys": [
        "freesurfer"
      ]
    }
  ],
  "outputs": [
    {
      "id": "wmc",
      "datatype": "neuro/wmc-deprecated",
      "datatype_tags": [
        "categories"
      ],
      "description": "unknown",
      "datatype_tags_pass": "track"
    },
    {
      "id": "classification",
      "datatype": "neuro/wmc",
      "datatype_tags": [
        "categories"
      ],
      "description": "unknown",
      "datatype_tags_pass": "track"
    }
  ],
  "parameters": [
