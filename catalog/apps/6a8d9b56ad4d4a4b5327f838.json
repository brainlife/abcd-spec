  "parameters": [
    {
      "id": "channel_types",
      "type": "string",
      "description": "Optional channel-type reassignments, comma-separated \"chan_name-new_type\" pairs (e.g. \"EEG061-eog,EEG062-eog,EEG063-ecg,EEG064-misc\" for a system that digitizes EOG/ECG through spare EEG channels). Applied via MNE's set_channel_types() before saving. Default: no reassignment.",
