      "required": false,
      "advanced": true
    },
    {
      "id": "rename_channels",
      "type": "string",
      "description": "Optional channel renames, comma-separated \"old_name-new_name\" pairs (e.g. \"EEG061-EOG061,EEG062-EOG062,EEG063-ECG063\"). Applied via MNE's rename_channels(), after channel_types. Default: no renaming.",
      "default": "",
      "required": false,
      "advanced": true
    }
  ],
  "runtime": {
    "container": "brainlifemeeg/mne:1.12.1",
