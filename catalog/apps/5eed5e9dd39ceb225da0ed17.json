{
  "spec": "brainlife-app/2.0",
  "name": "Compute summary statistics of diffusion measures mapped to cortical surface - Deprecated Surface",
  "version": "v1.1",
  "summary": "This app will This app will compute multiple summary statistics from measures mapped to the cortical midthickness surface on a per-ROI basis.",
  "description": "This app will This app will compute multiple summary statistics from measures mapped to the cortical midthickness surface on a per-ROI basis. This app takes in a cortexmap datatype and an optional parcellation/surface datatype. This app will compute the following summary statistics: minimum, maximum, mean, median, mode, standard deviation, sample standard deviation (n-1), and nonzero vertex count. The app will output a csv for each summary measure summarizing the diffusion measures in each ROI parcellation. If no parcellation surface is inputted, the app will just compute stats from the labels file found in the cortexmap datatype (usually aparc.a2009s.labels.gii). These csvs can be used for computing group averages and for performing machine learning analyses.",
  "kind": "native",
  "topics": [],
  "registry": {
    "id": "5eed5e9dd39ceb225da0ed17",
    "github": "brainlife/app-cortex-tissue-mapping-stats",
    "branch": "v1.1"
  },
  "inputs": [
    {
      "id": "cortexmap",
      "datatype": "neuro/cortexmap",
      "datatype_tags": [],
      "optional": false,
      "multi": false,
      "description": "Path to the cortexmap datatype folder",
      "config_keys": [
        "cortexmap"
      ]
    },
    {
      "id": "parc",
      "datatype": "neuro/parcellation/surface-deprecated",
      "datatype_tags": [],
      "optional": true,
      "multi": false,
      "description": "Path to individual parcellation and annotation files for parcellation/surface datatype. Files: lh_annot: lh.parc.annot.gii; rh_annot: rh.parc.annot.gii; lh_pial_surf: lh.parc.pial.gii; rh_pial_surf: rh.parc.pial.gii",
      "config_keys": [
        "lh_annot",
        "rh_annot",
        "lh_pial_surf",
        "rh_pial_surf"
      ]
    }
  ],
  "outputs": [
