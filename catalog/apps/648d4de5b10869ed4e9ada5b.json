{
  "spec": "brainlife-app/2.0",
  "name": "Structural network connectomics of visual white matter by polar angle and eccentricity - Single Endpoints",
  "version": "v1.1",
  "summary": "Builds polar-angle-by-eccentricity visual cortex parcels from pRF maps and segments the tractogram streamlines that terminate in each parcel and visual area, using Connectome Workbench, FSL and MRtrix3.",
  "description": "Projects the pRF polar-angle and eccentricity maps from the FreeSurfer surface into DWI space, bins them into wedges around the chosen polar-angle meridians and eccentricity steps, and combines them into a volumetric parcellation and cortexmap. In this single-endpoints variant it then assigns each streamline to the visual area and retinotopic bin of its endpoint with MRtrix3 and writes the per-bin tracts as a white matter classification. Use it to study visual white matter organised by visual-field position; needs a FREESURFER_LICENSE and inputs that share the subject's DWI space.",
  "kind": "native",
  "topics": [
    "dwi",
    "tract-segmentation",
    "connectomics",
    "mrtrix3",
    "connectome-workbench",
    "fsl",
    "brainlife-app"
  ],
  "registry": {
    "id": "648d4de5b10869ed4e9ada5b",
    "github": "bacaron/app-visual-white-matter",
    "branch": "v1.1"
  },
  "inputs": [
    {
      "id": "dwi",
      "datatype": "neuro/dwi",
      "datatype_tags": [],
      "optional": false,
      "multi": false,
      "description": "Preprocessed DWI, used as the reference space for the parcellation.",
      "config_keys": [
        "dwi",
        "bvecs",
        "bvals",
        "sbref",
        "sbref_json"
      ]
    },
    {
      "id": "freesurfer",
      "datatype": "neuro/freesurfer",
      "datatype_tags": [],
      "optional": false,
      "multi": false,
      "description": "FreeSurfer subject directory used to map surface pRF data to the volume.",
      "config_keys": [
        "freesurfer"
      ]
    },
    {
      "id": "prf",
      "datatype": "neuro/prf",
      "datatype_tags": [],
      "optional": false,
      "multi": false,
      "description": "pRF (population receptive field) maps on the surface, with polar angle and eccentricity.",
      "config_keys": [
        "prfVerticesDir",
        "prfSurfacesDir"
      ]
    },
    {
      "id": "track",
      "datatype": "neuro/track/tck",
      "datatype_tags": [],
      "optional": false,
      "multi": false,
      "description": "Whole-brain .tck tractogram in DWI space.",
      "config_keys": [
        "track"
      ]
    },
    {
      "id": "varea",
      "datatype": "neuro/parcellation/volume",
      "datatype_tags": [],
      "optional": false,
      "multi": false,
      "description": "Volumetric visual-area parcellation with its label.json.",
      "config_keys": [
        "varea_parc",
        "varea_label"
      ]
    }
  ],
  "outputs": [
    {
      "id": "parc",
      "datatype": "neuro/parcellation/volume",
      "datatype_tags": [
        "polarAngle_by_eccentricity"
      ],
      "description": "Volumetric polar-angle x eccentricity parcellation."
    },
    {
      "id": "cortexmap",
      "datatype": "neuro/cortexmap",
      "datatype_tags": [
        "polarAngle_by_eccentricity"
      ],
      "description": "Surface (cortexmap) versions of the polar-angle x eccentricity bins."
    },
    {
      "id": "track",
      "datatype": "neuro/track/tck",
      "datatype_tags": [
        "polarAngle_by_eccentricity",
        "single_endpoints"
      ],
      "description": "Tractogram of the streamlines assigned to visual-area / retinotopic bins."
    },
    {
      "id": "tracts",
      "datatype": "neuro/tcks",
      "datatype_tags": [
        "polarAngle_by_eccentricity",
        "single_endpoints"
      ],
      "description": "One .tck per segmented bin."
    },
    {
      "id": "wmc",
      "datatype": "neuro/wmc",
      "datatype_tags": [
        "polarAngle_by_eccentricity",
        "single_endpoints"
      ],
      "description": "White matter classification of the segmented streamlines."
    },
    {
      "id": "tractmeasures",
      "datatype": "neuro/tractmeasures",
      "datatype_tags": [
        "macro",
        "polarAngle_by_eccentricity",
        "single_endpoints"
      ],
      "description": "Macrostructural measures of the segmented tracts."
    },
    {
      "id": "raw",
      "datatype": "raw",
      "datatype_tags": [
        "polarAngle_by_eccentricity",
        "single_endpoints"
      ],
      "description": "Intermediate files (masks, MRtrix images, transforms and text outputs)."
    }
  ],
  "parameters": [
    {
      "id": "paMeridians",
      "type": "string",
      "description": "Space-separated polar-angle meridians (degrees) around which wedges are built.",
      "default": "0 45 90 135 180",
      "advanced": true
    },
    {
      "id": "paAngle",
      "type": "string",
      "description": "Half-width (degrees) of each polar-angle wedge around its meridian.",
      "default": "15",
      "advanced": true
    },
    {
      "id": "eccAngle",
      "type": "string",
      "description": "Width (degrees) of each eccentricity bin from 0 to 8 degrees.",
      "default": "2",
      "advanced": true
    },
    {
      "id": "inputparc",
      "type": "enum",
      "description": "FreeSurfer parcellation (aparc, aparc.a2009s or aparc.DKTatlas) used when building the cortexmap.",
      "default": "aparc.a2009s",
      "options": [
        {
          "value": "aparc",
          "label": "aparc",
          "description": "aparc"
        },
        {
          "value": "aparc.a2009s",
          "label": "aparc.a2009s",
          "description": "aparc.a2009s"
        },
        {
          "value": "aparc.DKTatlas",
          "label": "aparc.DKTatlas",
          "description": "aparc.DKTatlas"
        }
      ],
      "advanced": true
    },
    {
      "id": "assignment_radial_search",
      "type": "number",
      "description": "tck2connectome -assignment_radial_search distance; used only in the both_endpoints workflow, not in this App.",
      "default": 4,
      "advanced": true
    },
    {
      "id": "assignment_reverse_search",
      "type": "string",
      "description": "tck2connectome -assignment_reverse_search distance; used only in the both_endpoints workflow, not in this App.",
      "default": "",
      "required": false,
      "advanced": true
    },
    {
      "id": "assignment_forward_search",
      "type": "string",
      "description": "tck2connectome -assignment_forward_search distance; used only in the both_endpoints workflow, not in this App.",
      "default": "",
      "required": false,
      "advanced": true
    },
    {
      "id": "inv_length",
      "type": "boolean",
      "description": "Not read by the code.",
      "default": true,
      "advanced": true
    },
    {
      "id": "richClubPercentage",
      "type": "number",
      "description": "Percentile for the rich-club coefficient; used only in the both_endpoints workflow, not in this App.",
      "default": 90,
      "advanced": true
    },
    {
      "id": "analysis",
      "type": "enum",
      "description": "Analysis pipeline to run; only polarAngleMeridiansConnectomics is implemented.",
      "default": "polarAngleMeridiansConnectomics",
      "options": [
        {
          "value": "polarAngleMeridiansConnectomics",
          "label": "polarAngleMeridiansConnectomics",
          "description": "polarAngleMeridiansConnectomics"
        }
      ],
      "advanced": true
    },
    {
      "id": "include_periph",
      "type": "boolean",
      "description": "Add a peripheral eccentricity bin from 8 to 90 degrees.",
      "default": true,
      "advanced": true
    },
    {
      "id": "endpoints_assignment",
      "type": "enum",
      "description": "Assign streamlines by a single endpoint (this App) or by both endpoints.",
      "default": "single_endpoints",
      "options": [
        {
          "value": "both_endpoints",
          "label": "both_endpoints",
          "description": "both_endpoints"
        },
        {
          "value": "single_endpoints",
          "label": "single_endpoints",
          "description": "single_endpoints"
        }
      ],
      "advanced": true,
      "readonly": true
    }
  ],
  "runtime": {
    "container": "unknown",
    "resources": {
      "cpus": 8,
      "walltime_hours": 3
    },
    "licenses_required": [
      "FREESURFER_LICENSE"
    ]
  },
  "doi": "10.25663/brainlife.app.785",
  "software": [
    {
      "name": "Connectome Workbench",
      "version": "1.4.2"
    },
    {
      "name": "FreeSurfer"
    },
    {
      "name": "FSL",
      "version": "5.0.11"
    },
    {
      "name": "MRtrix3",
      "version": "3.0.3"
    },
    {
      "name": "DIPY",
      "version": "1.4.0"
    }
  ],
  "maintainers": [
    "Brad Caron"
  ]
}
