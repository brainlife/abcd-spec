{
  "spec": "brainlife-app/2.0",
  "name": "Apply warp to or from standard space to ROIs (T2w) - ACPC T2 space",
  "version": "v1.1",
  "summary": "Applies an existing FSL nonlinear warp to move ROIs between an ACPC-aligned T2-weighted image space and a standard template (MNI152 or NIHPD) with FSL applywarp.",
  "description": "Warps every NIfTI ROI in the input with FSL applywarp, using a warp/inverse-warp pair already computed for the subject (for example by an FSL fnirt registration App). Use warp to bring subject-space ROIs into template space or inv_warp to bring template-space ROIs into the subject's T2w space. It does not compute a registration; the transform input must have been computed from an ACPC-aligned T2w image of the same subject and the chosen template.",
  "kind": "native",
  "topics": [
    "anatomy",
    "brainlife-app",
    "fsl",
    "registration"
  ],
  "registry": {
    "id": "63cc4d91ef2a7449dccbb6dd",
    "github": "brainlife/app-register-rois-mni",
    "branch": "v1.1"
  },
  "inputs": [
    {
      "id": "t2",
      "datatype": "neuro/anat/t2w",
      "datatype_tags": [],
      "optional": false,
      "multi": false,
      "description": "T2-weighted image of the subject (ACPC-aligned); used as the target space when warping back to the subject.",
      "config_keys": [
        "input"
      ]
    },
    {
      "id": "rois",
      "datatype": "neuro/rois",
      "datatype_tags": [],
      "optional": false,
      "multi": false,
      "description": "Directory of NIfTI ROIs to warp; every file in it is warped.",
      "config_keys": [
        "rois",
        "label"
      ]
    },
    {
      "id": "warp",
      "datatype": "neuro/transform/nifti",
      "datatype_tags": [],
      "optional": false,
      "multi": false,
      "description": "Nonlinear transform (warp, inverse-warp and affine) between the subject's anatomical image and the chosen template.",
      "config_keys": [
        "warp",
        "inverse_warp",
        "affine"
      ],
      "requirements": "Must have been computed for the same subject, the same template and the same space (scanner or ACPC) selected in acpc_or_input."
    }
  ],
  "outputs": [
    {
      "id": "raw",
      "datatype": "raw",
      "datatype_tags": [
        "standard"
      ],
      "description": "Output directory for all the data derivatives generated",
      "datatype_tags_pass": "t2"
    },
    {
      "id": "rois",
      "datatype": "neuro/rois",
      "datatype_tags": [
        "warped"
      ],
      "description": "The ROIs resampled into the target space, binarized if binarize is set.",
      "datatype_tags_pass": "t2"
    }
  ],
  "parameters": [
    {
      "id": "input_type",
      "type": "enum",
      "description": "This controls the datatype (T1 or T2) to use. This should not be changed. Only used to keep the github repository between the two apps the same",
      "default": "T2",
      "options": [
        {
          "value": "T2",
          "label": "T2",
          "description": "T2"
        }
      ],
      "advanced": true
    },
    {
      "id": "template",
      "type": "enum",
      "description": "Standard template (MNI152 at several resolutions, MNI152NLin2009cAsym, or NIHPD pediatric) whose space the warp maps to or from; used as the applywarp reference.",
      "default": "MNI152_1mm",
      "options": [
        {
          "value": "MNI152_1mm",
          "label": "MNI152_1mm",
          "description": "1.0 mm MNI 152 template"
        },
        {
          "value": "nihpd_asym_04.5-08.5",
          "label": "4.5\u20138.5 y.o Asymmetric (natural) templates",
          "description": "4.5\u20138.5 y.o Asymmetric (natural) templates"
        },
        {
          "value": "nihpd_asym_04.5-18.5",
          "label": "4.5-18.5 y.o Asymmetric (natural) templates",
          "description": "4.5-18.5 y.o Asymmetric (natural) templates"
        },
        {
          "value": "nihpd_asym_07.0-11.0",
          "label": "7.0-11.0 y.o Asymmetric (natural) templates",
          "description": "7.0-11.0 y.o Asymmetric (natural) templates"
        },
        {
          "value": "nihpd_asym_07.5-13.5",
          "label": "7.5-13.5 y.o Asymmetric (natural) templates",
          "description": "7.5-13.5 y.o Asymmetric (natural) templates"
        },
        {
          "value": "nihpd_asym_10.0-14.0",
          "label": "10.0-14.0 y.o Asymmetric (natural) templates",
          "description": "10.0-14.0 y.o Asymmetric (natural) templates"
        },
        {
          "value": "nihpd_asym_13.0-18.5",
          "label": "13.0-18.5 y.o Asymmetric (natural) templates",
          "description": "13.0-18.5 y.o Asymmetric (natural) templates"
        },
        {
          "value": "MNI152_0.7mm",
          "label": "MNI152_0.7mm",
          "description": "0.7 mm MNI 152 template"
        },
        {
          "value": "MNI152_0.8mm",
          "label": "MNI152_0.8mm",
          "description": "0.8 mm MNI 152 template"
        },
        {
          "value": "MNI152_2mm",
          "label": "MNI152_2mm",
          "description": "2.0 mm MNI 152 template"
        },
        {
          "value": "tpl-MNI152NLin2009cAsym_res-01",
          "label": "tpl-MNI152NLin2009cAsym_res-01",
          "description": "tpl-MNI152NLin2009cAsym_res-01"
        },
        {
          "value": "tpl-MNI152NLin2009cAsym_res-02",
          "label": "tpl-MNI152NLin2009cAsym_res-02",
          "description": "tpl-MNI152NLin2009cAsym_res-02"
        }
      ]
    },
    {
      "id": "interp",
      "type": "enum",
      "description": "Interpolation passed to FSL applywarp when resampling the ROIs: nn (nearest neighbour, keeps labels and masks discrete) or spline.",
      "default": "nn",
      "options": [
        {
          "value": "nn",
          "label": "nn",
          "description": "nn"
        },
        {
          "value": "spline",
          "label": "spline",
          "description": "spline"
        }
      ],
      "advanced": true
    },
    {
      "id": "warp_to_use",
      "type": "enum",
      "description": "Which field to apply: warp (subject-to-template, moves subject-space ROIs into template space) or inv_warp (template-to-subject, moves template-space ROIs into subject space).",
      "default": "warp",
      "options": [
        {
          "value": "warp",
          "label": "warp",
          "description": "warp"
        },
        {
          "value": "inv_warp",
          "label": "inv_warp",
          "description": "inv_warp"
        }
      ]
    },
    {
      "id": "binarize",
      "type": "boolean",
      "description": "If true, binarize each warped ROI and fill holes with fslmaths -bin -fillh.",
      "default": true,
      "advanced": true
    },
    {
      "id": "acpc_or_input",
      "type": "enum",
      "description": "This is important for setting whether or not the affine is used",
      "default": "acpc",
      "options": [
        {
          "value": "acpc",
          "label": "acpc",
          "description": "acpc"
        }
      ],
      "advanced": true,
      "readonly": true
    }
  ],
  "runtime": {
    "container": "brainlife/fsl:6.0.4-patched2",
    "resources": {
      "cpus": 4,
      "walltime_hours": 8.5
    }
  },
  "doi": "10.25663/brainlife.app.718",
  "software": [
    {
      "name": "FSL",
      "version": "6.0.4",
      "url": "https://fsl.fmrib.ox.ac.uk/"
    }
  ]
}
