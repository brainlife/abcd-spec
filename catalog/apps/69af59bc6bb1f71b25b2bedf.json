  ],
  "parameters": [
    {
      "id": "forward_operation",
      "type": "boolean",
      "description": "Assume registration was performed as:\n\n    MOVING  \u2192  REFERENCE\n\nThis means the estimated transform maps MOVING space into REFERENCE space.\n\n\nBring tractogram FROM MOVING \u2192 REFERENCE space\n (default true)",
      "default": true
    },
    {
      "id": "reverse_operation",
      "type": "boolean",
      "description": "Assume registration was performed as:\n\n    MOVING  \u2192  REFERENCE\n\nThis means the estimated transform maps MOVING space into REFERENCE space.\nBring tractogram FROM REFERENCE \u2192 MOVING space\n\n (default false)",
      "default": false
    },
    {
      "id": "affine_only",
      "type": "boolean",
      "description": "Apply only the affine transformation",
      "default": false
    },
    {
      "id": "fsl_transform",
      "type": "boolean",
      "description": "If true, converts affine and warp to from FSL to ANTs-compatible format",
      "default": false
    },
    {
      "id": "verbose",
      "type": "boolean",
      "description": "verbose output in the log",
      "default": false
    }
  ],
  "runtime": {
    "container": "gamorosino/tract_align:latest",
    "resources": {
      "cpus": 1,
      "walltime_hours": 1
    }
