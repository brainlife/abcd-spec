{
  "spec": "brainlife-app/2.0",
  "name": "Extract diffusion metrics inside ROIs - Deprecated",
  "version": "v1.1",
  "summary": "This app will extracts diffusion metrics (tensor, NODDI) from within ROIs for ROI-level analysis using FSL. Will output metric x ROI NIFTI images. Takes in DWI, tensor, NODDI, and ROIs inputs and outputs a directory with the metric x ROI NIFTI images. Inflation can be performed on the ROIs using SPM.",
  "description": "unknown",
  "kind": "native",
  "topics": [],
  "registry": {
    "id": "5ed02c160a8ed81c69482f0f",
    "github": "brainlife/app-extract-diffusion-metrics-rois",
    "branch": "v1.1"
  },
  "inputs": [
    {
      "id": "dwi",
      "datatype": "neuro/dwi",
      "datatype_tags": [],
      "optional": false,
      "multi": false,
      "description": "The path to the DWI datatype",
      "config_keys": [
        "dwi",
        "bvecs",
        "bvals"
      ]
    },
    {
      "id": "tensor",
      "datatype": "neuro/tensor",
      "datatype_tags": [],
      "optional": false,
      "multi": false,
      "description": "The path to the tensor datatype files",
      "config_keys": [
        "fa",
        "md",
        "rd",
        "ad",
        "cl",
        "cp",
        "cs",
        "tensors",
        "kurtosis",
        "ga",
        "ak",
        "mk",
        "rk"
      ]
    },
    {
      "id": "noddi",
      "datatype": "neuro/noddi",
      "datatype_tags": [],
      "optional": false,
      "multi": false,
      "description": "The path to the NODDI datatype files",
      "config_keys": [
        "dir",
        "ndi",
        "isovf",
        "odi"
      ]
    },
    {
      "id": "rois",
      "datatype": "neuro/rois",
      "datatype_tags": [],
      "optional": false,
      "multi": false,
      "description": "The path to the top directory containing the ROIs within which diffusion metrics will be extracted",
      "config_keys": [
        "rois"
      ]
    }
  ],
  "outputs": [
    {
      "id": "raw",
      "datatype": "raw",
      "datatype_tags": [
        "dti_noddi_metrics"
      ],
      "description": "Directory with NIFTI images of each diffusion metrics extracted in each ROI"
    }
  ],
  "parameters": [
    {
      "id": "inflate",
      "type": "boolean",
      "description": "whether or not to inflate the data",
      "default": false
