{
  "spec": "brainlife-app/2.0",
  "name": "FIF to mne/raw",
  "version": "main",
  "summary": "Converts MEG FIF data to MNE Raw (fif)",
  "description": "Reads an MEG FIF file with mne.io.read_raw_fif and saves it as the MNE raw datatype. Use it to make a neuro/meg/fif dataset usable by Apps that expect meeg/mne/raw.",
  "kind": "native",
  "topics": [
    "brainlife-app",
    "conversion",
    "meg",
    "mne-python"
  ],
  "registry": {
    "id": "628b5c89d0697cf1eaeaffad",
    "github": "guiomar/app_fif2mne",
    "branch": "main"
  },
  "inputs": [
    {
      "id": "fif1",
      "datatype": "neuro/meg/fif",
      "datatype_tags": [],
      "optional": false,
      "multi": false,
      "description": "MEG recording (FIF) with BIDS sidecars.",
      "config_keys": [
        "fif",
        "channels",
        "headshape",
        "coordsystem",
        "calibration",
        "crosstalk",
        "destination",
        "events",
        "events_json"
      ]
    }
  ],
  "outputs": [
    {
      "id": "out_dir",
      "datatype": "neuro/meeg/mne/raw",
      "datatype_tags": [
        "meg",
        "fif",
        "converted"
      ],
      "description": "MNE Raw data in FIF format",
      "datatype_tags_pass": "fif1"
    }
  ],
  "parameters": [],
  "runtime": {
    "container": "brainlife/mne:0.23dev",
    "resources": {
      "cpus": 8
    }
  },
  "doi": "10.25663/brainlife.app.632",
  "software": [
    {
      "name": "MNE-Python",
      "url": "https://mne.tools"
    }
  ],
  "citations": [
    {
      "text": "Hayashi S, Caron BA, et al., Pestilli F. brainlife.io: A decentralized and open source cloud platform to support neuroscience research. arXiv (2023)."
    },
    {
      "doi": "10.3389/fnins.2013.00267",
      "text": "Gramfort A, et al. MEG and EEG data analysis with MNE-Python. Front Neurosci 7:267 (2013)."
    }
  ]
}
