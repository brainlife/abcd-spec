      "id": "T1_input",
      "datatype": "neuro/anat/t1w",
      "datatype_tags": [],
      "optional": false,
      "multi": false,
      "description": "T1-weighted MRI",
      "config_keys": [
        "t1"
      ]
    },
    {
      "id": "FLAIR_input",
