{
  "spec": "brainlife-app/2.0",
  "name": "multi-LAP and multi-NN (deprecated)",
  "version": "1.0",
  "summary": "White matter bundle segmentation as multiple Linear Assignment Problems (multi-LAP). It also performs Nearest Neighbor (NN, or multi-NN) segmentation for comparison. WARNING: This App was used specifically for a Replicability Study and has been deprecated.",
  "description": "unknown",
  "kind": "native",
  "topics": [
    "segmentation",
    "white-matter-segmentation"
  ],
