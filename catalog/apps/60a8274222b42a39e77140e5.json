{
  "spec": "brainlife-app/2.0",
  "name": "[WIP] Create animation from trk",
  "version": "master",
  "summary": "Work-in-progress utility that renders an animation of .trk streamlines over FreeSurfer cortical surfaces with Blender and outputs the rendered PNG frames.",
  "description": "Converts the FreeSurfer lh/rh orig.nofix surfaces to STL with mris_convert, then renders 720 1920x1080 frames of the streamlines and surfaces with Blender 2.82. Marked work in progress; the frames are not assembled into a movie (the ffmpeg step is commented out). Needs a GPU.",
  "kind": "native",
  "topics": [
    "brainlife-app",
    "dwi",
    "freesurfer",
    "visualization"
  ],
  "registry": {
    "id": "60a8274222b42a39e77140e5",
    "github": "soichih/app-trk2mp4",
    "branch": "master"
  },
  "inputs": [
    {
      "id": "trk",
      "datatype": "neuro/track/trk",
      "datatype_tags": [],
      "optional": false,
      "multi": false,
      "description": "Tractogram (.trk) to animate.",
      "config_keys": [
        "track"
      ]
    },
    {
      "id": "freesurfer",
      "datatype": "neuro/freesurfer",
      "datatype_tags": [],
      "optional": false,
      "multi": false,
      "description": "FreeSurfer subject directory providing the cortical surfaces.",
      "config_keys": [
        "freesurfer"
      ]
    }
  ],
  "outputs": [
    {
      "id": "output",
      "datatype": "raw",
      "datatype_tags": [
        "trk2mp4"
      ],
      "description": "Rendered animation frames (frame.N.png)."
    }
  ],
  "parameters": [],
  "runtime": {
    "container": "brainlife/freesurfer-mini:7.1.1",
    "licenses_required": [
      "FREESURFER_LICENSE"
    ]
  },
  "doi": "10.25663/brainlife.app.526",
  "software": [
    {
      "name": "FreeSurfer",
      "version": "7.1.1"
    },
    {
      "name": "Blender",
      "version": "2.82"
    }
  ],
  "failure_modes": [
    {
      "message": "Please set FREESURFER_LICENSE in .bashrc",
      "fix": "Provide a FreeSurfer license (FREESURFER_LICENSE)."
    }
  ]
}
