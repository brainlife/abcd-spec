      "options": [
        {
          "value": "stl",
          "label": ".stl",
          "description": "use .stl format"
        },
        {
          "value": "ply",
          "label": ".ply",
          "description": "use .ply format"
        },
        {
          "value": "vtk",
          "label": ".vtk",
          "description": "use .vtk format"
        },
        {
          "value": "glb",
