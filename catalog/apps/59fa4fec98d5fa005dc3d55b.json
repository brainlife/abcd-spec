{
  "spec": "brainlife-app/2.0",
  "name": "Decimate and/or Convert 3D surfaces",
  "version": "v2.0",
  "summary": "This application will reduce the number of vertices and faces on 3D surfaces by the percent reduction chosen. It can also be used to convert between filetypes.",
  "description": "unknown",
  "kind": "native",
  "topics": [
    "postprocessing"
  ],
