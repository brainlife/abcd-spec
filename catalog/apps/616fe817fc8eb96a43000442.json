  "parameters": [
    {
      "id": "fmin",
      "type": "number",
      "description": "Min frequency of interest.",
      "default": 0
    },
    {
      "id": "fmax",
      "type": "number",
      "description": "Max frequency of interest.",
      "default": 100,
      "required": true
    },
    {
      "id": "tmin",
      "type": "number",
      "description": "Min time of interest.",
      "required": false,
      "advanced": true,
      "placeholder": "None"
    },
    {
      "id": "tmax",
      "type": "number",
      "description": "Max time of interest.",
      "required": false,
      "advanced": true,
      "placeholder": "None"
    },
    {
      "id": "bandwidth",
      "type": "number",
      "description": "The bandwidth of the multi taper windowing function in Hz. The default value is a window half-bandwidth of 4.",
      "default": 4
    },
    {
      "id": "adaptive",
      "type": "boolean",
      "description": "Use adaptive weights to combine the tapered spectra into PSD (slow, use n_jobs >> 1 to speed up computation).",
      "default": false,
      "advanced": true
    },
    {
      "id": "low_bias",
      "type": "boolean",
      "description": "Only use tapers with more than 90% spectral concentration within bandwidth.",
      "default": true,
      "advanced": true
    },
    {
      "id": "normalization",
      "type": "enum",
      "description": "Either \u201cfull\u201d or \u201clength\u201d (default). If \u201cfull\u201d, the PSD will be normalized by the sampling rate as well as the length of the signal (as in nitime).",
      "default": "full",
      "options": [
        {
          "value": "full",
          "label": "Full",
          "description": "PSD will be normalized by the length of the signal"
        },
        {
          "value": "length",
          "label": "Length",
          "description": "the PSD will be normalized by the sampling rate as well as the length of the signal"
        }
      ],
      "advanced": true
    },
    {
      "id": "proj",
      "type": "boolean",
      "description": "Apply SSP projection vectors.",
      "default": false,
      "advanced": true
    },
    {
      "id": "picks",
      "type": "string",
      "description": "Channels to include. In lists, channel type strings (e.g., [meg, eeg]) will pick channels of those types, channel name strings (e.g., [MEG0111, MEG2623]) will pick the given channels. When you use a list, don't forget to use the square brackets. Can also be the string values \u201call\u201d to pick all channels, or \u201cdata\u201d to pick data channels. None will pick all data channels. Note that channels in info['bads'] will be included if their names are explicitly provided.",
      "default": "None",
      "required": true,
      "advanced": true,
      "readonly": true
    }
  ],
  "runtime": {
    "container": "brainlife/mne:0.23dev",
    "resources": {
      "cpus": 8
    }
