{
  "spec": "brainlife-app/2.0",
  "name": "T1w-to-T1w Registration",
  "version": "v0.1",
  "summary": "An automated and reproducible pipeline to perform image registration between two T1-weighted anatomical MRI scans using ANTs.",
  "description": "unknown",
  "kind": "native",
  "topics": [],
  "registry": {
    "id": "682d177a0c9315be198f7d59",
    "github": "gamorosino/app-registration-t1w",
    "branch": "v0.1"
  },
  "inputs": [
    {
      "id": "t1_moving",
      "datatype": "neuro/anat/t1w",
      "datatype_tags": [],
      "optional": false,
      "multi": false,
      "description": "unknown",
      "config_keys": [
        "t1"
      ]
    },
    {
      "id": "t1_fixed",
      "datatype": "neuro/anat/t1w",
      "datatype_tags": [],
      "optional": false,
      "multi": false,
      "description": "unknown",
      "config_keys": [
        "t1_fixed"
      ]
    }
  ],
  "outputs": [
    {
      "id": "transformations",
      "datatype": "neuro/transform/nifti",
      "datatype_tags": [],
      "description": "unknown"
    },
    {
      "id": "transformed",
      "datatype": "neuro/anat/t1w",
      "datatype_tags": [],
      "description": "unknown"
    }
  ],
  "parameters": [
    {
      "id": "settings",
      "type": "enum",
      "description": "The `settings` parameter controls the depth of the multiresolution (pyramidal) registration strategy used by ANTs. Higher settings correspond to more levels in the registration pyramid, starting from coarse alignment and progressively refining toward finer spatial correspondence.",
      "default": "4",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ]
    },
    {
      "id": "transformation",
      "type": "enum",
      "description": "unknown",
      "default": "nonlinear",
      "options": [
        {
          "value": "translation",
          "label": "1",
          "description": "Translation"
        },
        {
          "value": "rigid",
          "label": "2",
          "description": "Rigid Transformation"
        },
        {
          "value": "affine",
          "label": "3",
          "description": "Affine Transformation"
        },
        {
          "value": "nonlinear",
          "label": "4",
          "description": "Diffeomorphic Symmetric (SyN) Transformation"
        }
      ]
    }
  ],
  "runtime": {
    "container": "brainlife/ants:2.2.0-1bc",
    "resources": {
      "cpus": 1,
      "walltime_hours": 2
    }
  },
  "doi": "10.25663/brainlife.app.861"
}
