  "outputs": [
    {
      "id": "output",
      "datatype": "neuro/track/trk",
      "datatype_tags": [],
      "description": "unknown"
    }
  ],
  "parameters": [
    {
      "id": "step_size",
      "type": "number",
      "description": "Step size used for tracking (default 0.2mm).",
      "default": 0.2
    },
    {
      "id": "seed_density",
      "type": "number",
      "description": "Number of seeds per dimension inside voxel (default 1). For example, seed_density of 2 means 8 regularly distributed points in the voxel.",
      "default": 1
    },
    {
      "id": "pmf_threshold",
      "type": "number",
      "description": "Threshold for ODF functions (default 0.1).",
      "default": 0.1
    },
    {
      "id": "max_angle",
      "type": "number",
      "description": "Maximum angle between streamline segments (range [0, 90], default 20).",
      "default": 20
    },
    {
      "id": "pft_back",
      "type": "number",
      "description": "Distance in mm to back track before starting the particle filtering tractography (default 2mm). The total particle filtering tractography distance is equal to back_tracking_dist + front_tracking_dist.",
      "default": 2
    },
    {
      "id": "pft_front",
      "type": "number",
      "description": "Distance in mm to run the particle filtering tractography after the back track distance (default 1mm). The total particle filtering tractography distance is equal to back_tracking_dist + front_tracking_dist.",
      "default": 1
    },
    {
      "id": "pft_count",
      "type": "number",
      "description": "Number of particles to use in the particle filter (default 15).",
      "default": 15
    }
  ],
  "runtime": {
    "container": "brainlife/dipy:1.1.1",
    "resources": {
      "cpus": 8
    }
  },
