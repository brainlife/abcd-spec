{
  "spec": "brainlife-app/2.0",
  "name": "Multi-Atlas Transfer Tool",
  "version": "0.0.10",
  "summary": "Maps a chosen cortical atlas (Schaefer, Gordon, Yeo, HCP-MMP, AAL and others) onto a subject's FreeSurfer surfaces with maTT2 GCS classifiers and outputs volumetric and surface parcellations.",
  "description": "Implements maTT2 from the multi-atlas transfer tools: atlas GCS files trained on Mindboggle-101 are applied with FreeSurfer to the subject's recon-all output, then the labels are remapped to consecutive integers and written as a volume in the subject T1w space, as GIfTI surface labels and as a brain mask. Use it to get an atlas parcellation (with 14 FreeSurfer subcortical regions) for connectivity or ROI analyses. Needs a completed FreeSurfer recon-all directory and a FreeSurfer license.",
  "kind": "native",
  "topics": [
    "anatomy",
    "parcellation",
    "freesurfer",
    "brainlife-app"
  ],
  "registry": {
    "id": "6016dcdc321a4aafce6decd5",
    "github": "bacaron/app-multiAtlasTT",
    "branch": "0.0.10"
  },
  "inputs": [
    {
      "id": "fsin",
      "datatype": "neuro/freesurfer",
      "datatype_tags": [],
      "optional": false,
      "multi": false,
      "description": "Completed FreeSurfer recon-all subject directory.",
      "config_keys": [
        "fsin"
      ]
    }
  ],
  "outputs": [
    {
      "id": "parc-vol",
      "datatype": "neuro/parcellation/volume",
      "datatype_tags": [
        "SupraTentorial"
      ],
      "description": "Volumetric parcellation (parc.nii.gz) in subject space with key.txt and label.json."
    },
    {
      "id": "parc-surf-verts",
      "datatype": "neuro/surface/vertices",
      "datatype_tags": [],
      "description": "Left and right white, pial and inflated surfaces (GIfTI)."
    },
    {
      "id": "parc-surf-data",
      "datatype": "neuro/surface/data",
      "datatype_tags": [],
      "description": "Atlas labels on the left and right surfaces (GIfTI) with key and label files."
    },
    {
      "id": "mask",
      "datatype": "neuro/mask",
      "datatype_tags": [
        "brain",
        "anat"
      ],
      "description": "Brain mask derived from the FreeSurfer aparc+aseg."
    }
  ],
  "parameters": [
    {
      "id": "atlas",
      "type": "enum",
      "description": "Atlas to map onto the subject's cortex.",
      "default": "",
      "options": [
        {
          "value": "gordon333dil",
          "label": "gordon333dil"
        },
        {
          "value": "yeo17dil",
          "label": "yeo17dil"
        },
        {
          "value": "hcp-mmp-b",
          "label": "hcp-mmp-b"
        },
        {
          "value": "schaefer100-yeo17",
          "label": "schaefer100-yeo17"
        },
        {
          "value": "schaefer200-yeo17",
          "label": "schaefer200-yeo17"
        },
        {
          "value": "schaefer400-yeo17 ",
          "label": "schaefer400-yeo17 "
        },
        {
          "value": "schaefer500-yeo17",
          "label": "schaefer500-yeo17"
        },
        {
          "value": "schaefer300-yeo17",
          "label": "schaefer300-yeo17"
        },
        {
          "value": "shen268cort",
          "label": "shen268cort"
        },
        {
          "value": "baldassano",
          "label": "baldassano"
        },
        {
          "value": "arslan",
          "label": "arslan"
        },
        {
          "value": "aal",
          "label": "aal"
        },
        {
          "value": "nspn500",
          "label": "nspn500"
        },
        {
          "value": "aicha",
          "label": "aicha"
        },
        {
          "value": "ica",
          "label": "ica",
          "description": "does not actually do ICA!!!"
        }
      ]
    }
  ],
  "runtime": {
    "container": "faskowit/app-multiatlastt:0.0.8",
    "resources": {
      "cpus": 1,
      "memory_gb": 8,
      "walltime_hours": 2
    },
    "licenses_required": [
      "FREESURFER_LICENSE"
    ]
  },
  "doi": "10.25663/brainlife.app.470",
  "software": [
    {
      "name": "FreeSurfer"
    },
    {
      "name": "multiAtlasTT",
      "url": "https://github.com/faskowit/multiAtlasTT"
    },
    {
      "name": "nibabel"
    }
  ],
  "citations": [
    {
      "text": "Fischl B, et al. Automatically parcellating the human cerebral cortex. Cereb Cortex 14:11-22 (2004)."
    }
  ]
}
