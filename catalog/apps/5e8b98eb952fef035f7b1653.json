{
  "spec": "brainlife-app/2.0",
  "name": "Merge Tractography (tcks) together with MRTrix3 (Two Tcks)",
  "version": "two-tck",
  "summary": "Merges two tractograms into one .tck file with MRtrix3 tckedit.",
  "description": "Concatenates the streamlines of two .tck tractograms into track/track.tck using MRtrix3 tckedit. It is a two-input copy of the mergeTCK App, made as a workaround for brainlife pipelines that cannot pass multi-input datasets. Both tractograms should be in the same space.",
  "kind": "native",
  "topics": [
    "tractography",
    "mrtrix3",
    "brainlife-app"
  ],
  "registry": {
    "id": "5e8b98eb952fef035f7b1653",
    "github": "bacaron/app-mergeTCK",
    "branch": "two-tck"
  },
  "inputs": [
    {
      "id": "track1",
      "datatype": "neuro/track/tck",
      "datatype_tags": [],
      "optional": false,
      "multi": false,
      "description": "First tractogram (.tck) to merge.",
      "config_keys": [
        "track1"
      ]
    },
    {
      "id": "track2",
      "datatype": "neuro/track/tck",
      "datatype_tags": [],
      "optional": false,
      "multi": false,
      "description": "Second tractogram (.tck) to merge.",
      "config_keys": [
        "track2"
      ]
    }
  ],
  "outputs": [
    {
      "id": "track",
      "datatype": "neuro/track/tck",
      "datatype_tags": [
        "merged"
      ],
      "description": "Single .tck tractogram containing the streamlines of both inputs."
    }
  ],
  "parameters": [],
  "runtime": {
    "container": "brainlife/mrtrix3:3.0_RC3",
    "resources": {
      "cpus": 4
    }
  },
  "doi": "10.25663/brainlife.app.305",
  "software": [
    {
      "name": "MRtrix3",
      "version": "3.0_RC3",
      "url": "https://www.mrtrix.org/"
    }
  ],
  "failure_modes": [
    {
      "message": "failed",
      "cause": "tckedit did not produce track/track.tck.",
      "fix": "Check that both inputs are valid .tck files."
    }
  ],
  "maintainers": [
    "Sophia Vinci-Booher",
    "Brad Caron"
  ]
}
