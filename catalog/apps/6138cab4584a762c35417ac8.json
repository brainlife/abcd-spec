{
  "spec": "brainlife-app/2.0",
  "name": "Apply warp to Parcellation",
  "version": "parc-v1.0",
  "summary": "Applies an existing FSL nonlinear warp to a volumetric parcellation with FSL applywarp (nearest neighbour), resampling it into MNI152 2 mm or NIHPD template space.",
  "description": "Runs applywarp with nearest-neighbour interpolation on the parcellation using the supplied warp, with MNI152 T1 2 mm as reference for every MNI choice or the selected NIHPD template, and copies label.json and key.txt. It does not compute a registration; the warp must map the parcellation's space to the chosen template.",
  "kind": "native",
  "topics": [
    "brainlife-app",
    "fsl",
    "parcellation",
    "registration"
  ],
  "registry": {
    "id": "6138cab4584a762c35417ac8",
    "github": "brainlife/app-warp-bold",
    "branch": "parc-v1.0"
  },
  "inputs": [
    {
      "id": "parc",
      "datatype": "neuro/parcellation/volume",
      "datatype_tags": [],
      "optional": false,
      "multi": false,
      "description": "Volumetric parcellation with label.json (and key.txt if present).",
      "config_keys": [
        "input",
        "key",
        "label"
      ]
    },
    {
      "id": "transform",
      "datatype": "neuro/transform/nifti",
      "datatype_tags": [],
      "optional": false,
      "multi": false,
      "description": "Nonlinear warp field (warp) to the template space.",
      "config_keys": [
        "warp"
      ],
      "requirements": "Must map the parcellation's space to the selected template."
    }
  ],
  "outputs": [
    {
      "id": "output",
      "datatype": "neuro/parcellation/volume",
      "datatype_tags": [
        "warped"
      ],
      "description": "The warped parcellation datatype",
      "datatype_tags_pass": "parc"
    }
  ],
  "parameters": [
    {
      "id": "template",
      "type": "enum",
      "description": "Template defining the output space: any MNI152 option uses the MNI152 T1 2 mm image as applywarp reference; NIHPD options use the matching pediatric template.",
      "default": "MNI152_1mm",
      "options": [
        {
          "value": "MNI152_1mm",
          "label": "MNI152_1mm",
          "description": "The 1mm MNI_152 template"
        },
        {
          "value": "nihpd_asym_04.5-08.5",
          "label": "4.5\u20138.5 y.o Asymmetric (natural) templates",
          "description": "4.5\u20138.5 y.o Asymmetric (natural) templates"
        },
        {
          "value": "nihpd_asym_04.5-18.5",
          "label": "4.5-18.5 y.o Asymmetric (natural) templates",
          "description": "4.5-18.5 y.o Asymmetric (natural) templates"
        },
        {
          "value": "nihpd_asym_07.0-11.0",
          "label": "7.0-11.0 y.o Asymmetric (natural) templates",
          "description": "7.0-11.0 y.o Asymmetric (natural) templates"
        },
        {
          "value": "nihpd_asym_07.5-13.5",
          "label": "7.5-13.5 y.o Asymmetric (natural) templates",
          "description": "7.5-13.5 y.o Asymmetric (natural) templates"
        },
        {
          "value": "nihpd_asym_10.0-14.0",
          "label": "10.0-14.0 y.o Asymmetric (natural) templates",
          "description": "10.0-14.0 y.o Asymmetric (natural) templates"
        },
        {
          "value": "nihpd_asym_13.0-18.5",
          "label": "13.0-18.5 y.o Asymmetric (natural) templates",
          "description": "13.0-18.5 y.o Asymmetric (natural) templates"
        }
      ]
    }
  ],
  "runtime": {
    "container": "brainlife/fsl:6.0.4",
    "resources": {
      "cpus": 2,
      "memory_gb": 12,
      "walltime_hours": 0.5
    }
  },
  "doi": "10.25663/brainlife.app.569",
  "software": [
    {
      "name": "FSL",
      "version": "6.0.4",
      "url": "https://fsl.fmrib.ox.ac.uk/"
    }
  ]
}
