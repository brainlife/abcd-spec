{
  "spec": "brainlife-app/2.0",
  "name": "Generate images of tract endpoints on cortical surface",
  "version": "tract-endpoints-v1.0",
  "summary": "Projects tract endpoint density ROIs onto the FreeSurfer white surface and renders JPEG images of each on the cortical surface with PySurfer, for visual quality control.",
  "description": "Maps every volume in the ROIs datatype to the left and/or right white surface with mri_vol2surf (hemisphere inferred from the file name), then draws each map on the chosen surface with PySurfer using the chosen colormap and percentile range, saving several views as JPEGs. Use it to inspect where tracts terminate on the cortex. ROIs must be in the FreeSurfer subject's space (header registration is assumed). Visualisation only.",
  "kind": "native",
  "topics": [
    "visualization",
    "quality-control",
    "tractography",
    "freesurfer",
    "brainlife-app"
  ],
  "registry": {
    "id": "6109ecd3b991116939bee534",
    "github": "brainlife/app-cortex-mapping-images",
    "branch": "tract-endpoints-v1.0"
  },
  "inputs": [
    {
      "id": "freesurfer",
      "datatype": "neuro/freesurfer",
      "datatype_tags": [],
      "optional": false,
      "multi": false,
      "description": "Path to the freesurfer dataset. Needed for image generation, even when surface = midthickness",
      "config_keys": [
        "freesurfer"
      ]
    },
    {
      "id": "rois",
      "datatype": "neuro/rois",
      "datatype_tags": [
        "tractEndpointDensity"
      ],
      "optional": false,
      "multi": false,
      "description": "Tract endpoint density volumes, one NIfTI per tract end; files whose names contain left/lh or right/rh are mapped to that hemisphere only.",
      "config_keys": [
        "rois",
        "label"
      ],
      "requirements": "Must be aligned to the FreeSurfer subject (mri_vol2surf --regheader)."
    }
  ],
  "outputs": [
    {
      "id": "images",
      "datatype": "generic/images",
      "datatype_tags": [
        "qa_image",
        "tract_endpoints"
      ],
      "description": "File containing multiple images of different views of each tract endpoint",
      "datatype_tags_pass": "rois"
    }
  ],
  "parameters": [
    {
      "id": "surface",
      "type": "enum",
      "description": "Surface to use in the image. Pial, white, and inflated come from freesurfer's standard segmentation. Midthickness comes from Cortex Mapping datatype",
      "default": "inflated",
      "options": [
        {
          "value": "pial",
          "label": "pial",
          "description": "pial"
        },
        {
          "value": "white",
          "label": "white",
          "description": "white"
        },
        {
          "value": "inflated",
          "label": "inflated",
          "description": "inflated"
        }
      ]
    },
    {
      "id": "min_percentile",
      "type": "number",
      "description": "Minimum percentile to map to colorbar",
      "default": 4,
      "advanced": true
    },
    {
      "id": "max_percentile",
      "type": "number",
      "description": "Maximum percentile to map to colorbar",
      "default": 96,
      "advanced": true
    },
    {
      "id": "threshold",
      "type": "number",
      "description": "Threshold value to use for computing minimum,  median, and maximum values to map colormap to.\n\nWill update to plot only data above threshold once functionality is available.",
      "default": 1e-09,
      "advanced": true
    },
    {
      "id": "colormap",
      "type": "enum",
