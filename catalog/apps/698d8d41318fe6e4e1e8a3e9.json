{
  "spec": "brainlife-app/2.0",
  "name": "fitlins",
  "version": "main",
  "summary": "fit linear models to BIDS datasets",
  "description": "Wraps FitLins to fit a first-level (run-level) GLM to a preprocessed BOLD run: it generates a BIDS Stats Model from readable settings (condition column, HRF, contrasts, confound strategy), stages a minimal BIDS and derivatives layout with the events and fMRIPrep confounds, and runs FitLins. Use it for single-subject task fMRI activation maps without writing a Stats Model by hand. Inputs should be fMRIPrep outputs in the selected space with a matching events.tsv; group-level analysis is not supported.",
  "kind": "native",
  "topics": [
    "fmri",
    "statistics",
    "bids",
    "nilearn",
    "brainlife-app"
  ],
  "registry": {
    "id": "698d8d41318fe6e4e1e8a3e9",
    "github": "jdkent/app-fitlins",
    "branch": "main"
  },
  "inputs": [
    {
      "id": "bold",
      "datatype": "neuro/func/task",
      "datatype_tags": [
        "preprocessed"
      ],
      "optional": false,
      "multi": false,
      "description": "Preprocessed BOLD run (typically fMRIPrep desc-preproc BOLD).",
      "config_keys": [
        "bold"
      ]
    },
    {
      "id": "events",
      "datatype": "neuro/func/task",
      "datatype_tags": [],
      "optional": false,
      "multi": false,
      "description": "Raw task/events dataset containing events.tsv aligned to this run.",
      "config_keys": [
        "events_tsv"
      ]
    },
    {
      "id": "confounds",
      "datatype": "neuro/regressors",
      "datatype_tags": [],
      "optional": false,
      "multi": false,
      "description": "fMRIPrep confounds dataset (regressors.tsv/json).",
      "config_keys": [
        "confounds_tsv",
        "confounds_json"
      ]
    },
    {
      "id": "brain_mask",
      "datatype": "neuro/mask",
      "datatype_tags": [
        "func",
        "brain"
      ],
      "optional": true,
      "multi": false,
      "description": "Optional brain mask in BOLD space.",
      "config_keys": [
        "brain_mask"
      ],
      "advanced": true
    }
  ],
  "outputs": [
    {
      "id": "fitlins_output",
      "datatype": "raw",
      "datatype_tags": [
        "fitlins"
      ],
      "description": "FitLins output directory (maps, design TSV, report)."
    },
    {
      "id": "model_output",
      "datatype": "raw",
      "datatype_tags": [
        "stats-model"
      ],
      "description": "Generated first-level BIDS Stats Model and summary."
    }
  ],
  "parameters": [
    {
      "id": "repetition_time",
      "type": "number",
      "description": "Fallback TR in seconds when BOLD JSON is missing.",
      "default": 2,
      "advanced": true
    },
    {
      "id": "design_name",
      "type": "string",
      "description": "Model name shown in generated Stats Model JSON.",
      "default": "brainlife_fitlins_model"
    },
    {
      "id": "design_description",
      "type": "string",
      "description": "Short model description for provenance/reporting.",
      "default": "First-level model generated by brainlife FitLins app.",
      "advanced": true
    },
    {
      "id": "condition_column",
      "type": "string",
      "description": "Events TSV column containing condition labels.",
      "default": "trial_type"
    },
    {
      "id": "include_conditions",
      "type": "string",
      "description": "Optional conditions to include (comma-separated). Leave blank to auto-detect from events.tsv.",
      "default": ""
    },
    {
      "id": "convolve_conditions",
      "type": "string",
      "description": "Optional subset to convolve with HRF (comma-separated). Leave blank to convolve all included conditions.",
      "default": ""
    },
    {
      "id": "hrf_model",
      "type": "enum",
      "description": "HRF model used for convolution.",
      "default": "spm",
      "options": [
        {
          "value": "spm",
          "label": "SPM",
          "description": "SPM canonical HRF."
        },
        {
          "value": "glover",
          "label": "Glover",
          "description": "Glover canonical HRF."
        }
      ]
    },
    {
      "id": "contrasts_json",
      "type": "string",
      "description": "Optional JSON array of contrasts, e.g. [{\"name\":\"incongruent_gt_congruent\",\"weights\":{\"incongruent\":1,\"congruent\":-1}}].",
      "default": ""
    },
    {
      "id": "auto_task_vs_baseline",
      "type": "boolean",
      "description": "If no manual contrasts are provided, create task_vs_baseline automatically.",
      "default": true,
      "advanced": true
    },
    {
      "id": "auto_dummy_contrasts",
      "type": "boolean",
      "description": "Generate one t-contrast per included condition.",
      "default": true,
      "advanced": true
    },
    {
      "id": "confounds_strategy",
      "type": "enum",
      "description": "Nuisance regressor strategy.",
      "default": "acompcor6",
      "options": [
        {
          "value": "acompcor6",
          "label": "aCompCor + motion",
          "description": "Recommended first-level default."
        },
        {
          "value": "motion_24",
          "label": "Motion 24",
          "description": "24-parameter motion expansion."
        },
        {
          "value": "basic",
          "label": "Basic motion",
          "description": "6 rigid-body motion terms."
        },
        {
          "value": "none",
          "label": "None",
          "description": "No strategy-selected confounds."
        }
      ]
    },
    {
      "id": "include_framewise_displacement",
      "type": "boolean",
      "description": "Include framewise_displacement when available.",
      "default": true
    },
    {
      "id": "include_dvars",
      "type": "boolean",
      "description": "Include dvars when available.",
      "default": true
    },
    {
      "id": "include_cosine_drift_terms",
      "type": "boolean",
      "description": "Include cosine drift terms from confounds TSV.",
      "default": false,
      "advanced": true
    },
    {
      "id": "confounds_strict",
      "type": "boolean",
      "description": "Fail if chosen confounds are not consistent across runs.",
      "default": false,
      "advanced": true
    },
    {
      "id": "fitlins_space",
      "type": "enum",
      "description": "Space used to select preprocessed BOLD.",
      "default": "MNI152NLin2009cAsym",
      "options": [
        {
          "value": "MNI152NLin2009cAsym",
          "label": "MNI152NLin2009cAsym"
        },
        {
          "value": "MNI152NLin6Asym",
          "label": "MNI152NLin6Asym"
        },
        {
          "value": "T1w",
          "label": "T1w"
        }
      ]
    },
    {
      "id": "fitlins_desc_label",
      "type": "string",
      "description": "desc label to select for BOLD images.",
      "default": "preproc",
      "advanced": true
    },
    {
      "id": "fitlins_estimator",
      "type": "enum",
      "description": "Estimator backend for first-level GLM.",
      "default": "nilearn",
      "options": [
        {
          "value": "nilearn",
          "label": "Nilearn",
          "description": "Recommended default."
        },
        {
          "value": "afni",
          "label": "AFNI",
          "description": "AFNI 3dREMLfit backend."
        },
        {
          "value": "nistats",
          "label": "Nistats (legacy)",
          "description": "Legacy alias of nilearn."
        }
      ],
      "advanced": true
    },
    {
      "id": "fitlins_drift_model",
      "type": "enum",
      "description": "Drift model for first-level fit.",
      "default": "cosine",
      "options": [
        {
          "value": "cosine",
          "label": "Cosine"
        },
        {
          "value": "polynomial",
          "label": "Polynomial"
        }
      ],
      "advanced": true
    },
    {
      "id": "fitlins_n_cpus",
      "type": "integer",
      "description": "Maximum number of CPUs used by FitLins.",
      "default": 2,
      "advanced": true
    },
    {
      "id": "fitlins_mem_gb",
      "type": "number",
      "description": "Maximum memory (GB) used by FitLins.",
      "default": 8,
      "advanced": true
    },
    {
      "id": "fitlins_drop_missing",
      "type": "boolean",
      "description": "Drop missing model elements instead of failing.",
      "default": true,
      "advanced": true
    },
    {
      "id": "dry_run",
      "type": "boolean",
      "description": "Generate model/staging only; skip FitLins execution.",
      "default": false,
      "advanced": true
    },
    {
      "id": "model_json_path",
      "type": "string",
      "description": "Optional absolute path to a custom Stats Model JSON file.",
      "default": "",
      "advanced": true
    },
    {
      "id": "subject_label",
      "type": "string",
      "description": "Optional subject label override (e.g., 01). Use when input filename is not BIDS-like.",
      "default": "",
      "advanced": true
    },
    {
      "id": "session_label",
      "type": "string",
      "description": "Optional session label override (e.g., 01).",
      "default": "",
      "advanced": true
    },
    {
      "id": "task_label",
      "type": "string",
      "description": "Task label (e.g., stroop). If omitted, app infers from filename when possible.",
      "default": ""
    },
    {
      "id": "run_label",
      "type": "string",
      "description": "Optional run label override (e.g., 01).",
      "default": "",
      "advanced": true
    },
    {
      "id": "convolve_map_json",
      "type": "string",
      "description": "Per-condition HRF toggle map (JSON object). Example: {\"word\": true, \"pseudoword\": false}. This overrides convolve_conditions when provided.",
      "default": ""
    }
  ],
  "runtime": {
    "container": "poldracklab/fitlins:0.11.0",
    "resources": {
      "memory_gb": 24,
      "walltime_hours": 12
    }
  },
  "doi": "10.25663/brainlife.app.890",
  "software": [
    {
      "name": "FitLins",
      "version": "0.11.0",
      "url": "https://github.com/poldracklab/fitlins"
    },
    {
      "name": "nilearn"
    }
  ],
  "citations": [
    {
      "text": "Hayashi S, Caron BA, et al. brainlife.io: A decentralized and open source cloud platform to support neuroscience research (2023). https://www.ncbi.nlm.nih.gov/pmc/articles/PMC10274934/"
    },
    {
      "doi": "10.7554/eLife.71774",
      "text": "Markiewicz CJ, et al. The OpenNeuro resource for sharing of neuroscience data. eLife (2021)."
    }
  ]
}
