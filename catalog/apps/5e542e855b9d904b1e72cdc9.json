{
  "spec": "brainlife-app/2.0",
  "name": "Trekker ROI Tracking (dwi) - v1.0",
  "version": "master-app-v1.0",
  "summary": "Brainlife App (wrapper) for dMRI based fiber tracking between ROIs using parallel transport tractography",
  "description": "unknown",
  "kind": "native",
  "topics": [
    "diffusion-mri",
    "mri",
    "tracking",
    "tractography",
    "vision"
  ],
  "registry": {
    "id": "5e542e855b9d904b1e72cdc9",
    "github": "brainlife/app-trekker-roi-tracking",
    "branch": "master-app-v1.0"
  },
  "inputs": [
