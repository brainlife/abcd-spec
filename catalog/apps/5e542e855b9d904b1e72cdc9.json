      "id": "dwi",
      "datatype": "neuro/dwi",
      "datatype_tags": [],
      "optional": false,
      "multi": false,
      "description": "unknown",
      "config_keys": [
        "dwi",
        "bvecs",
        "bvals"
      ]
    },
    {
      "id": "csd",
      "datatype": "neuro/csd",
      "datatype_tags": [],
      "optional": false,
      "multi": false,
      "description": "unknown",
      "config_keys": [
        "response",
        "lmax2",
        "lmax4",
        "lmax6",
        "lmax8",
        "lmax10",
        "lmax12",
        "lmax14"
      ]
    },
    {
      "id": "rois",
      "datatype": "neuro/rois",
      "datatype_tags": [],
      "optional": false,
      "multi": false,
      "description": "unknown",
      "config_keys": [
        "rois"
      ]
    },
    {
      "id": "mask",
      "datatype": "neuro/mask",
      "datatype_tags": [
        "5tt_masks"
      ],
      "optional": true,
      "multi": false,
      "description": "unknown",
      "config_keys": [
        "mask"
      ]
    },
    {
      "id": "brainmask",
      "datatype": "neuro/mask",
      "datatype_tags": [],
      "optional": true,
      "multi": false,
      "description": "unknown",
      "config_keys": [
        "brainmask"
      ]
    },
    {
      "id": "anat",
      "datatype": "neuro/anat/t1w",
      "datatype_tags": [],
      "optional": false,
      "multi": false,
      "description": "unknown",
      "config_keys": [
        "anat"
      ]
    },
    {
      "id": "wm_mask",
      "datatype": "neuro/mask",
      "datatype_tags": [
        "white_matter"
      ],
      "optional": true,
      "multi": false,
      "description": "This is the path to the precomputed white matter mask. If left empty, a white matter mask will be computed automatically",
      "config_keys": [
        "wm_mask"
      ]
    }
  ],
  "outputs": [
    {
      "id": "track",
      "datatype": "neuro/track/tck",
      "datatype_tags": [
        "roi_trekker"
      ],
      "description": "unknown"
    },
    {
      "id": "wmc",
      "datatype": "neuro/wmc",
      "datatype_tags": [
        "roi_trekker"
      ],
      "description": "unknown"
    },
    {
      "id": "brainmask",
      "datatype": "neuro/mask",
      "datatype_tags": [
        "brain_mask"
      ],
      "description": "unknown"
    },
    {
      "id": "5tt",
      "datatype": "neuro/mask",
      "datatype_tags": [],
      "description": "unknown"
    }
  ],
  "parameters": [
    {
      "id": "min_length",
      "type": "number",
      "description": "min length of streamlines",
      "default": 10
    },
    {
      "id": "max_length",
      "type": "number",
      "description": "max length of streamlines",
      "default": 200
    },
    {
      "id": "lmax",
      "type": "number",
      "description": "maximum lmax. if no input, then app will automatically calculate",
      "default": 8,
      "required": false
    },
    {
      "id": "minfodamp",
      "type": "string",
      "description": "Minimum FOD amplitude (default: 0.025)",
      "default": "0.025"
    },
    {
      "id": "roiPair",
      "type": "string",
      "description": "roiPair for tracking. input seed roi first and termination roi second\nex. \"seed term\"",
      "default": "",
      "multiline": true
    },
    {
      "id": "exclusion",
      "type": "string",
      "description": "these are the names of the exclusion ROIs you would like to use. Follows the same format as roiPair field. For example, if you want to track in both hemispheres, you could enter \"exclusion_L exclusion_R\". \n\nPlease look at your ROIs datatype for the exact name of your exclusion ROI.\n\nIf you do not want to include exclusion ROIs, leave this empty",
      "default": "",
      "required": false,
      "multiline": true
    },
    {
      "id": "stepsize",
      "type": "string",
      "description": "unknown",
      "default": "0.25"
    },
    {
      "id": "count",
      "type": "number",
      "description": "total number of streamlines",
      "default": 500
    },
    {
      "id": "maxtrials",
      "type": "number",
      "description": "Sets the maximum number of attempts to generate streamline from the seed point. Default=1000000.",
      "default": 1000000
    },
    {
      "id": "curvatures",
      "type": "string",
      "description": "minimum radius of curvatures. can be multiple (i.e. ensemble) or one value. default: 1",
      "default": "1"
    },
    {
      "id": "maxsampling",
      "type": "number",
      "description": "This option limits the number of samples that can be tested for rejection sampling during propagation. Default=10000.",
      "default": 10000
    },
    {
      "id": "single_lmax",
      "type": "boolean",
      "description": "Determines whether single lmax (true) or ensemble lmax (false) will be performed",
      "default": true
    },
    {
      "id": "probelength",
      "type": "number",
      "description": "Trekker: Length of the probe. Pick 1/4 of the smallest of the FOD(input dwi) voxel dimensions. For whole-brain tractography, use 1.0",
      "default": 0.25,
      "advanced": true
    },
    {
      "id": "probecount",
      "type": "number",
      "description": "Trekker: Determines the number of lines outside the cylinder. Default: 1, i.e: by default, the radius of the cylinder (probeRadius) is zero and only a single line is used to model a cylinder.",
      "default": 1,
      "advanced": true
    },
    {
      "id": "probequality",
      "type": "number",
      "description": "Trekker: This parameter sets the number of segments to split the cylinder along the length of the probe. The larger the value is, the slower the computation gets. Default=4.",
      "default": 4,
      "advanced": true
    },
    {
      "id": "proberadius",
      "type": "number",
      "description": "Trekker: Probe radius. Default: 0",
      "default": 0,
      "advanced": true
    },
    {
      "id": "reslice",
      "type": "boolean",
      "description": "reslice rois into diffusion space if true",
      "default": false
    }
  ],
  "runtime": {
    "container": "brainlife/freesurfer-mini:6.0.1",
    "resources": {
      "cpus": 8,
      "memory_gb": 30,
      "walltime_hours": 8
    },
    "licenses_required": [
      "FREESURFER_LICENSE"
    ]
  },
  "doi": "10.25663/brainlife.app.280",
