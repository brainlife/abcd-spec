{
  "spec": "brainlife-app/2.0",
  "name": "Register DWI to T1 with FSL",
  "version": "main",
  "summary": "Example code on how to run an FSL command in brainlife",
  "description": "unknown",
  "kind": "native",
  "topics": [],
  "registry": {
