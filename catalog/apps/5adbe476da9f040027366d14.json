{
  "spec": "brainlife-app/2.0",
  "name": "ANTs tensor registration based on FA",
  "version": "1.2",
  "summary": "FA-based non linear ANTs registration of the tensor to the FMRIB58_FA_1mm.nii.gz template or the IITmean_FA template.",
  "description": "unknown",
  "kind": "native",
  "topics": [
    "alignment"
  ],
  "registry": {
    "id": "5adbe476da9f040027366d14",
    "github": "giulia-berto/app-ants-FA-registration",
    "branch": "1.2"
  },
  "inputs": [
    {
      "id": "0",
      "datatype": "neuro/tensor",
      "datatype_tags": [],
      "optional": false,
      "multi": false,
      "description": "tensor to be aligned to the template",
      "config_keys": [
        "fa_moving",
        "md_moving",
        "rd_moving",
        "ad_moving"
      ]
    }
  ],
  "outputs": [
    {
      "id": "warp",
      "datatype": "neuro/transform/nifti",
      "datatype_tags": [
        "fa_warping"
      ],
      "description": "non linear warp (warp and inverse-warp)"
    },
    {
      "id": "tensor_aligned",
      "datatype": "neuro/tensor",
      "datatype_tags": [],
      "description": "aligned tensor",
      "datatype_tags_pass": "0"
    }
  ],
  "parameters": [
    {
      "id": "fa_template",
      "type": "enum",
      "description": "FA template",
      "default": "FMRIB58_FA_1mm",
      "options": [
        {
          "value": "FMRIB58_FA_1mm",
          "label": "FMRIB58_FA_1mm"
        },
        {
          "value": "IITmean_FA",
          "label": "IITmean_FA"
        }
      ]
    }
  ],
  "runtime": {
    "container": "brainlife/ants:2.2.0",
    "resources": {
      "cpus": 4,
      "memory_gb": 8,
      "walltime_hours": 1
    }
  },
  "doi": "10.25663/brainlife.app.118"
}
