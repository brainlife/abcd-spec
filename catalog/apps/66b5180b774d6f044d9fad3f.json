{
  "spec": "brainlife-app/2.0",
  "name": "XformPauliVTA",
  "version": "master",
  "summary": "Transforms Pauli Atlas VTA ROI from MNI space into subject space.",
  "description": "unknown",
  "kind": "native",
  "topics": [],
  "registry": {
    "id": "66b5180b774d6f044d9fad3f",
    "github": "ethan-ellis-uark/app-XformPauliVTA",
    "branch": "master"
  },
  "inputs": [
    {
      "id": "t1",
      "datatype": "neuro/anat/t1w",
      "datatype_tags": [
        "acpc_aligned"
      ],
      "optional": false,
      "multi": false,
      "description": "Subject T1 is used to compute transform files for Pauli VTA ROI.",
      "config_keys": [
        "t1"
      ]
    }
  ],
  "outputs": [
    {
      "id": "ROIs",
      "datatype": "neuro/rois",
      "datatype_tags": [
        "anat"
      ],
      "description": "Output directory for ROI nifti files"
    },
    {
      "id": "xform",
      "datatype": "neuro/transform/nifti",
      "datatype_tags": [
        "ANTs",
        "MNI152"
      ],
      "description": "Output directory for ANTs xform files"
    }
  ],
  "parameters": [
    {
      "id": "brainMask",
      "type": "boolean",
      "description": "Toggles script to run BET brain mask extraction.",
      "default": true
    },
    {
      "id": "binarize",
      "type": "boolean",
      "description": "Performs binarization of thresholded VTA ROI.",
      "default": true
    },
    {
      "id": "split",
      "type": "boolean",
      "description": "Splits thresholded and binarized VTA ROI into left and right hemispheres.",
      "default": true
    },
    {
      "id": "maskThreshold",
      "type": "number",
      "description": "Threshold value for voxel inclusion in xformed VTA ROI.",
      "default": 0.3,
      "minimum": 0,
      "maximum": 1
    }
  ],
  "runtime": {
    "container": "brainlife/fsl:5.0.9",
    "resources": {
      "cpus": 1
    }
  },
  "doi": "10.25663/brainlife.app.828"
}
