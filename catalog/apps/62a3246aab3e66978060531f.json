    {
      "id": "n_jobs",
      "type": "number",
      "description": "The number of jobs to run in parallel. If -1, it is set to the number of CPU cores. Requires the joblib package. None (default) is a marker for \u2018unset\u2019 that will be interpreted as n_jobs=1 (sequential execution) unless the call is performed under a joblib.parallel_backend() context manager that sets another value for n_jobs. Number of jobs to use to compute covariance.",
      "default": 1,
      "required": false,
      "advanced": true
    },
    {
      "id": "meg",
      "type": "enum",
