{
  "spec": "brainlife-app/2.0",
  "name": "Hybrid QSM-weighted T1 Generator",
  "version": "main",
  "summary": "Generates a hybrid contrast (HC) image that combines T1-weighted (T1w) MRI images and Quantitative Susceptibility Mapping (QSM) images. The HC image improves contrast in subcortical gray matter (SGM) structures, enhancing visibility and aiding in segmentation tasks.",
  "description": "unknown",
  "kind": "native",
  "topics": [],
  "registry": {
    "id": "6722807d851d5f6d75426b00",
    "github": "astewartau/hybrid-qsm-t1-brainlife",
    "branch": "main"
  },
  "inputs": [
    {
      "id": "t1",
      "datatype": "neuro/anat/t1w",
      "datatype_tags": [],
      "optional": false,
      "multi": false,
      "description": "unknown",
      "config_keys": [
        "t1"
      ]
    },
    {
      "id": "qsm",
      "datatype": "neuro/qsm",
      "datatype_tags": [],
      "optional": false,
      "multi": false,
      "description": "unknown",
      "config_keys": [
        "qsm"
      ]
    }
  ],
  "outputs": [
    {
      "id": "hybrid",
      "datatype": "neuro/anat/t1w",
      "datatype_tags": [
        "HC-QSM"
      ],
      "description": "Hybrid contrast QSM-weighted T1 image.",
      "datatype_tags_pass": "t1"
    }
  ],
  "parameters": [
    {
      "id": "w1",
      "type": "number",
      "description": "Weighting coefficient for the T1 image.",
      "default": 1.5
    },
    {
      "id": "w2",
      "type": "number",
      "description": "Weighting coefficient for the QSM image."
    }
  ],
  "runtime": {
    "container": "python:3.9-bookworm",
    "resources": {
      "memory_gb": 1,
      "walltime_hours": 0.25
    }
  },
  "doi": "10.25663/brainlife.app.836"
}
