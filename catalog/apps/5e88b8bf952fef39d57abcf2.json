{
  "spec": "brainlife-app/2.0",
  "name": "Anatomically Constrained Tractography using precomputed 5tt & CSD",
  "version": "1.3",
  "summary": "Runs mrtrix3 ACT (Anatomically Constrained Tractography) using either single- or multi-shell diffusion-weighted MRI data. Clone of https://doi.org/10.25663/bl.app.101 (written by Brent McPherson) that requires csd input and allows for 5tt probability mask and brainmask inputs.",
  "description": "unknown",
  "kind": "native",
  "topics": [],
  "registry": {
    "id": "5e88b8bf952fef39d57abcf2",
    "github": "bacaron/app-mrtrix3-act",
    "branch": "1.3"
  },
  "inputs": [
    {
      "id": "dwi",
      "datatype": "neuro/dwi",
      "datatype_tags": [],
      "optional": false,
      "multi": false,
      "description": "The path to the DWI datatype",
      "config_keys": [
        "dwi",
        "bvecs",
        "bvals"
      ]
    },
    {
      "id": "anat",
      "datatype": "neuro/anat/t1w",
      "datatype_tags": [],
      "optional": false,
      "multi": false,
      "description": "The path to the anat/t1w datatype",
      "config_keys": [
        "anat"
      ]
    },
    {
      "id": "mask",
      "datatype": "neuro/mask",
      "datatype_tags": [
        "5tt_masks"
      ],
      "optional": true,
      "multi": false,
      "description": "The path to the  5tt probability mask generated using the Tissue-type Segmentation app.",
      "config_keys": [
        "mask"
      ]
    },
    {
      "id": "brainmask",
      "datatype": "neuro/mask",
      "datatype_tags": [
        "brain",
        "dwi"
      ],
      "optional": true,
      "multi": false,
      "description": "The path to the brainmask of the dwi",
      "config_keys": [
        "brainmask"
      ]
    },
    {
      "id": "csd",
      "datatype": "neuro/csd",
      "datatype_tags": [],
      "optional": false,
      "multi": false,
      "description": "The path to the CSD datatype files",
      "config_keys": [
        "response",
        "lmax2",
        "lmax4",
        "lmax6",
        "lmax8",
        "lmax10",
        "lmax12",
        "lmax14"
      ]
    }
  ],
  "outputs": [
    {
      "id": "tracking",
      "datatype": "neuro/track/tck",
      "datatype_tags": [],
      "description": "The whole-brain tractogram, formatted as a .tck file"
    },
    {
      "id": "tensor",
      "datatype": "neuro/tensor",
      "datatype_tags": [],
      "description": "The DTI output generated using MRTrix3"
    }
  ],
  "parameters": [
    {
      "id": "tensor_fit",
      "type": "string",
      "description": "If multi-shell data is passed, this selects the shell that will be extracted and have a tensor fit performed\n\nIf single-shell data is passed, this is ignored",
      "default": "",
      "required": false
    },
    {
      "id": "min_length",
      "type": "number",
      "description": "the minimum length a streamline may be",
      "default": 10
    },
    {
      "id": "max_length",
      "type": "number",
      "description": "the maximum length a streamline may be",
      "default": 200
    },
    {
      "id": "imaxs",
      "type": "number",
      "description": "The lmax(s) or maximum value to create tractography data",
      "default": 8
    },
    {
      "id": "ens_lmax",
      "type": "boolean",
      "description": "perform ensemble tracking on every lmax up to the maximum value passed",
      "default": true
    },
    {
      "id": "curvs",
      "type": "string",
      "description": "the maximum curvature angle streamline can take during tracking",
      "default": "5 10 20 40 80"
    },
    {
      "id": "num_fibers",
      "type": "number",
      "description": "the number of streamlines to produce per parameter combination",
      "default": 15000
    },
    {
      "id": "do_dtdt",
      "type": "boolean",
      "description": "perform tensor-based deterministic tractography",
      "default": true
    },
    {
      "id": "do_dtpb",
      "type": "boolean",
      "description": "perform tensor-based probabilistic tractography",
      "default": false
    },
    {
      "id": "do_detr",
      "type": "boolean",
      "description": "perform deterministic tractography",
      "default": true
    },
    {
      "id": "do_prb1",
      "type": "boolean",
      "description": "perform mrtrix2 probabilistic tractography",
      "default": false
    },
    {
      "id": "do_prb2",
      "type": "boolean",
      "description": "perform mrtrix3 probabilistic tractography",
      "default": true
    },
    {
      "id": "do_fact",
      "type": "boolean",
      "description": "Perform FACT tracking",
      "default": false
    },
    {
      "id": "fact_dirs",
      "type": "number",
      "description": "The number of directions to perform FACT tracking on.\nmin: 1 max: 5",
      "default": 3,
      "minimum": 1,
      "maximum": 5
    },
    {
      "id": "fact_fibs",
      "type": "number",
      "description": "The number of FACT fibers to track per lmax.\nmin: 0 max: 1000000",
      "default": 0,
      "minimum": 0,
      "maximum": 1000000
    },
    {
      "id": "premask",
      "type": "boolean",
      "description": "If the input anatomical T1s have already been skull stripped, check this to prevent 5ttgen from cutting off a portion of the brain. (This sets -premasked option for 5ttgens)",
      "default": false,
      "advanced": true
    },
    {
      "id": "stepsize",
      "type": "number",
      "description": "If you want to predefine step size, do it here",
      "advanced": true
    }
  ],
  "runtime": {
    "container": "brainlife/mrtrix3:3.0_RC3"
  },
  "doi": "10.25663/brainlife.app.297"
}
