    {
      "id": "robust",
      "type": "boolean",
      "description": "Use robust brain centre estimation (-R). Slower but more reliable for unusual head shapes.",
      "default": false
    },
    {
      "id": "bias_neck_cleanup",
      "type": "boolean",
      "description": "Bias-field + neck-cleanup pass (-B). Recommended when neck is included in the FOV.",
      "default": false
    }
  ],
  "runtime": {
    "container": "brainlife/fsl:6.0.4",
