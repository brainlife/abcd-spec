      "datatype": "neuro/anat/t1w",
      "datatype_tags": [],
      "optional": false,
      "multi": false,
      "description": "The path to the anat/t1w datatype to be aligned",
      "config_keys": [
        "input"
      ]
    }
  ],
  "outputs": [
