{
  "spec": "brainlife-app/2.0",
  "name": "Align T1 to ACPC Plane (HCP-based) - deprecated",
  "version": "1.4",
  "summary": "This app will align a T1w image to the ACPC plane (specifically, the MNI152_T1_1mm template from FSL using a 6 DOF alignment via FSL commands. This protocol was adapted from the HCP Preprocessing Pipeline (https://github.com/Washington-University/HCPpipelines.git). Requires a T1w image input and outputs an acpc_aligned T1w image.",
  "description": "unknown",
  "kind": "native",
