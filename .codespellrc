[codespell]
# Ref: https://github.com/codespell-project/codespell#using-a-config-file
skip = .git*,.codespellrc,testdata,config.json
check-hidden = true
# ignore-regex = 
# Words copied verbatim from brainlife registry records (App names, defaults) or domain terms
ignore-words-list = te,onl,seperate,thi,inbetween,lable,burnin
